<!DOCTYPE html>
<html lang="en">
  {% include "component/head.njk" %}
  <body class="policy-page">
    <header class="policy-nav-header">
      <div class="container policy-nav-inner">
        <a href="/" class="policy-brand" style="display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <img src="/assets/images/general/sage.webp" alt="Sage" class="brand-logo" width="36" height="36" style="border-radius: 8px;">
          <span style="font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.01em;">SAGE<span class="text-accent" style="font-size: 0.8em;">.IS</span></span>
        </a>
        <a href="/" class="back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Sage
        </a>
      </div>
    </header>

    <main class="policy-main">
      <div class="container">
        {{ content | safe }}
      </div>
    </main>

    {% include "component/footer.njk" %}
    {% include "component/scripts.njk" %}
  </body>
</html>
