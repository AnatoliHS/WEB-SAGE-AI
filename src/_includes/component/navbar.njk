{% set base = "" if (page.url == "/" or page.url == "/index.html") else "/" %}
{% set navLinks = [
    { id: "hero", label: "Home" },
    { id: "about", label: "About" },
    { id: "portal", label: "Exam Portal" },
    { id: "topics", label: "Hygiene Topics" },
    { id: "products", label: "Products" },
    { id: "faq", label: "FAQ" },
    { id: "smile", label: "Your Smile" }
] %}
<header id="main-header">
    <div class="nav-left">
        <a href="{{ base }}#hero" class="nav-mark" aria-label="Sheena Osborne RDH, home">
            <img src="/assets/lavender-logo.png" alt="">
        </a>
        <span class="nav-where" id="nav-where" aria-live="polite"><span>Welcome</span></span>
    </div>

    <button class="nav-contact" type="button" data-nav-panel="contact" aria-expanded="false" aria-controls="nav-contact-panel" aria-label="Contact">
        <span class="nav-swap"><span>Contact</span><span>Close</span></span>
        <span class="nav-contact-ic">
            <svg class="ic-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <svg class="ic-msg" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.5h7a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7.5L4.5 14v-2.5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
            <svg class="ic-x" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
    </button>

    <button class="nav-menu-btn" type="button" data-nav-panel="menu" aria-expanded="false" aria-controls="nav-menu-panel" aria-label="Menu">
        <span class="nav-swap"><span>Menu</span><span>Close</span></span>
        <span class="nav-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
</header>

<div class="nav-scrim" data-nav-close></div>

<nav class="nav-menu-panel" id="nav-menu-panel" aria-label="Site">
    <ul class="nav-links">
        {% for link in navLinks %}
        <li style="--i: {{ loop.index0 }}"><a href="{{ base }}#{{ link.id }}" data-section-link="{{ link.id }}">{{ link.label }}</a></li>
        {% endfor %}
        <li style="--i: {{ navLinks | length }}"><a href="{{ base }}#contact" data-section-link="contact" data-nav-open="contact">Contact</a></li>
    </ul>
    <div class="nav-menu-aside">
        <div><h3>Write</h3><p>{{ site.email }}</p></div>
        <div><h3>Hours</h3><p>Mon to Fri, 8:00 to 17:00</p></div>
        <div><h3>Where</h3><p>Durham Region, Ontario</p></div>
        <div><h3>Call</h3><p>{{ site.phone }}</p></div>
        <span class="nav-sig">Sheena</span>
    </div>
</nav>

<div class="nav-contact-panel" id="nav-contact-panel" role="dialog" aria-label="Contact Sheena">
    <div class="ncp-intro">
        <p class="ncp-eyebrow ncp" style="--i: 0">Contact</p>
        <h2 class="ncp-title ncp" style="--i: 1">Book a <em>consultation</em></h2>
        <p class="ncp-text ncp" style="--i: 2">Tell Sheena a little about what you need, whether that's a cleaning, help with your home-care routine, or a question about products.</p>
        <dl class="ncp-details ncp" style="--i: 3">
            <div><dt>Email</dt><dd>{{ site.email }}</dd></div>
            <div><dt>Hours</dt><dd>Monday to Friday, 8:00 to 17:00</dd></div>
            <div><dt>Where</dt><dd>Durham Region, Ontario</dd></div>
        </dl>
    </div>

    <form class="ncp-form" id="nav-contact-form" novalidate>
        <div class="ncp-field ncp" style="--i: 2">
            <input id="ncp-name" name="name" type="text" placeholder=" " autocomplete="name" required>
            <label for="ncp-name">Your name</label>
        </div>
        <div class="ncp-field ncp" style="--i: 3">
            <input id="ncp-email" name="email" type="email" placeholder=" " autocomplete="email" required>
            <label for="ncp-email">Email</label>
        </div>
        <fieldset class="ncp-reasons ncp" style="--i: 4">
            <legend>I'm interested in</legend>
            <input type="radio" name="reason" id="ncp-r-clean" value="Cleaning" checked><label for="ncp-r-clean">A cleaning</label>
            <input type="radio" name="reason" id="ncp-r-coach" value="Home-care coaching"><label for="ncp-r-coach">Home-care coaching</label>
            <input type="radio" name="reason" id="ncp-r-products" value="Product advice"><label for="ncp-r-products">Product advice</label>
            <input type="radio" name="reason" id="ncp-r-other" value="Other"><label for="ncp-r-other">Something else</label>
        </fieldset>
        <div class="ncp-field wide ncp" style="--i: 5">
            <textarea id="ncp-msg" name="message" rows="3" placeholder=" "></textarea>
            <label for="ncp-msg">Message (optional)</label>
        </div>
        <div class="ncp-actions ncp" style="--i: 6">
            <button class="ncp-send" type="submit">Send request
                <span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </button>
        </div>
    </form>

    <div class="ncp-done" id="nav-contact-done" hidden>
        <h3>Thank you, <span id="ncp-done-name"></span>.</h3>
        <p>Sheena will reply to <span id="ncp-done-email"></span> about scheduling.</p>
        <button type="button" id="ncp-again">Send another request</button>
    </div>
</div>
