{% set base = "" if (page.url == "/" or page.url == "/index.html") else "/" %}

<!-- Header bar that fades in once the brand docks -->
<div class="site-header-bar" aria-hidden="true"></div>

<!-- Logo mark, top far left -->
<a href="{{ base }}#hero" id="header-logo" class="header-logo" aria-label="Tinker home">
  <img src="/favicon.svg" alt="" width="32" height="32">
</a>

<!-- Dynamic brand: sits large in the hero at the top of the page, docks next to the logo once scrolling starts -->
<a href="{{ base }}#hero" id="dynamic-brand" class="wordmark dynamic-brand" aria-label="Tinker Click home">
  <span class="tinker-word">TINKER</span>
  <span class="click-word">CLICK</span>
</a>

<!-- Waitlist CTA in the top-right corner (also closes the drawer) -->
<button type="button" id="btn-waitlist-trigger" class="btn header-cta" aria-expanded="false" aria-controls="waitlist-dropdown-drawer">
  <span class="label-open">Join waitlist</span>
  <span class="label-close">Close</span>
  <svg class="cta-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M7 1.5v11M1.5 7h11"/>
  </svg>
</button>

<!-- Top-down waitlist drawer -->
<div id="waitlist-dropdown-drawer" class="waitlist-drawer" hidden>
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
    <div class="container drawer-grid">
      <div class="drawer-intro">
        <span class="eyebrow">(Waitlist) Private Alpha</span>
        <h2 class="drawer-title" id="drawer-title">Be first <span class="text-muted">to tinker.</span></h2>
      </div>

      <div class="drawer-form-col">
        <p class="drawer-copy">
          Tinker is in private alpha. Join the waitlist at <strong>tinker.click</strong> and we'll email you when it opens to more people.
        </p>

        <form id="signup" class="signup-form" action="https://tinker.click/subscribe.php" method="post" novalidate>

          <label class="sr-only" for="email">Email address</label>
          <div class="composer">
            <input id="email" name="email" type="email" inputmode="email" autocomplete="email"
                   placeholder="you@example.com" required maxlength="254">
            <button type="submit" class="btn btn-primary btn-submit">
              Notify me
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </button>
          </div>

          <!-- Honeypot -->
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
          </div>

          <p id="status" class="status" role="status" aria-live="polite"></p>
        </form>

        <p class="drawer-fine">Tinker will email you news about Tinker. Unsubscribe any time.</p>
      </div>
    </div>
  </div>
</div>
