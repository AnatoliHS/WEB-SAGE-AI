{% set fbase = "" if (page.url == "/" or page.url == "/index.html") else "/" %}
<footer class="site-footer">
    <div class="container">
        <div class="footer-top">
            <div class="footer-lead">
                <p class="footer-lead-title">Healthier gums start <span class="title-faded">at home.</span></p>
                <a href="{{ fbase }}#contact" class="pill-btn" data-nav-open="contact">
                    Book a consultation
                    <span class="pill-btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </a>
                <div class="footer-socials">
                    <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon-btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>
                    </a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-icon-btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                    <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="social-icon-btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                    <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube" class="social-icon-btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.5 6.4a2.8 2.8 0 0 0-1.9-2C18.9 4 12 4 12 4s-6.9 0-8.6.5a2.8 2.8 0 0 0-1.9 2A29 29 0 0 0 1 11.8a29 29 0 0 0 .5 5.3 2.8 2.8 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.8 2.8 0 0 0 1.9-1.9 29 29 0 0 0 .5-5.3 29 29 0 0 0-.5-5.4z"/><path d="M9.8 15l5.7-3.2-5.7-3.3z"/></svg>
                    </a>
                    <a href="mailto:{{ site.email }}" aria-label="Email" class="social-icon-btn">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                    </a>
                </div>
            </div>

            <nav class="footer-col" aria-label="Explore">
                <h2 class="footer-col-title">Explore</h2>
                <ul class="footer-links">
                    <li><a href="{{ fbase }}#about">About Sheena</a></li>
                    <li><a href="{{ fbase }}#portal">Exam Portal</a></li>
                    <li><a href="{{ fbase }}#smile">Your Smile</a></li>
                    <li><a href="{{ fbase }}#topics">Hygiene Advice</a></li>
                    <li><a href="{{ fbase }}#products">Products</a></li>
                    <li><a href="{{ fbase }}#faq">FAQ</a></li>
                </ul>
            </nav>

            <nav class="footer-col" aria-label="Exam categories">
                <h2 class="footer-col-title">Exam categories</h2>
                <ul class="footer-links">
                    {% for c in portal.categories %}
                    <li><a href="{{ fbase }}#portal" data-portal-open="{{ c.n }}">{{ c.name }}</a></li>
                    {% endfor %}
                </ul>
            </nav>

            <div class="footer-col">
                <h2 class="footer-col-title">Contact</h2>
                <ul class="footer-contact">
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                        <span>Durham Region, Ontario</span>
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
                        <a href="tel:+15550198822">(555) 019-8822</a>
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        <span>Mon to Fri, 8:00 to 17:00</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="footer-copy">&copy; 2026 Sheena Osborne RDH. All rights reserved.</p>
            <ul class="footer-legal">
                <li><a href="/privacy/">Privacy</a></li>
                <li><a href="/terms/">Terms</a></li>
                <li><a href="/cookies/">Cookies</a></li>
            </ul>
            <p class="footer-credit">Design and development by <a href="https://chastech.ca" target="_blank" rel="noopener">ChasTech Inc.</a></p>
        </div>
        <p class="footer-disclaimer">Some product links are affiliate links. Commissions help support this free educational site.</p>

        <p class="footer-wordmark" aria-hidden="true"><span>Sheena</span> <span>Osborne</span></p>
    </div>
</footer>
