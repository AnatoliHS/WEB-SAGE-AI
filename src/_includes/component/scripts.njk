<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {

        // Falling & Rotating Teeth Animation Setup
        const teethContainer = document.getElementById('falling-teeth-container');
        if (teethContainer) {
            const toothCount = 35; // Total tooth particles
            const toothImgSrc = '/assets/tooth.png';

            for (let i = 0; i < toothCount; i++) {
                const tooth = document.createElement('img');
                tooth.src = toothImgSrc;
                tooth.alt = '';
                tooth.className = 'falling-tooth';

                // Organic randomized properties
                const size = Math.floor(Math.random() * 42) + 24; // 24px to 66px different sizes
                const leftPos = (Math.random() * 94 + 1).toFixed(2); // Random X positions (1% - 95%)
                const duration = (Math.random() * 10 + 8).toFixed(2); // 8s to 18s smooth fall rate
                const delay = (Math.random() * duration).toFixed(2); // Initial position distribution
                const startRot = Math.floor(Math.random() * 360);
                const rotDirection = Math.random() > 0.5 ? 1 : -1;
                const rotSpan = rotDirection * (360 + Math.floor(Math.random() * 540)); // 360-900 deg rotation
                const sway = ((Math.random() - 0.5) * 90).toFixed(2); // Horizontal drift/sway
                const maxOpacity = (Math.random() * 0.35 + 0.35).toFixed(2); // 0.35 to 0.70 visible opacity

                tooth.style.width = `${size}px`;
                tooth.style.height = 'auto';
                tooth.style.left = `${leftPos}%`;
                tooth.style.setProperty('--start-rot', `${startRot}deg`);
                tooth.style.setProperty('--end-rot', `${startRot + rotSpan}deg`);
                tooth.style.setProperty('--sway', `${sway}px`);
                tooth.style.setProperty('--max-opacity', maxOpacity);
                tooth.style.animation = `fallingTooth ${duration}s linear infinite`;
                tooth.style.animationDelay = `-${delay}s`;

                teethContainer.appendChild(tooth);
            }

            // Special Clean Tooth particle (/assets/clean.png) - Appears once every 20 seconds
            const cleanTooth = document.createElement('img');
            cleanTooth.src = '/assets/clean.png';
            cleanTooth.alt = '';
            cleanTooth.className = 'falling-tooth special-clean-tooth';

            function triggerCleanTooth() {
                const size = Math.floor(Math.random() * 24) + 40; // 40px to 64px prominent size
                const leftPos = (Math.random() * 84 + 6).toFixed(2); // 6% to 90%
                const startRot = Math.floor(Math.random() * 360);
                const rotDirection = Math.random() > 0.5 ? 1 : -1;
                const rotSpan = rotDirection * (360 + Math.floor(Math.random() * 360));
                const sway = ((Math.random() - 0.5) * 80).toFixed(2);

                cleanTooth.style.animation = 'none';
                void cleanTooth.offsetWidth; // DOM reflow trigger to restart animation
                cleanTooth.style.width = `${size}px`;
                cleanTooth.style.height = 'auto';
                cleanTooth.style.left = `${leftPos}%`;
                cleanTooth.style.setProperty('--start-rot', `${startRot}deg`);
                cleanTooth.style.setProperty('--end-rot', `${startRot + rotSpan}deg`);
                cleanTooth.style.setProperty('--sway', `${sway}px`);
                cleanTooth.style.setProperty('--max-opacity', '0.85');
                cleanTooth.style.animation = 'fallingTooth 12s linear 1';
            }

            cleanTooth.addEventListener('click', (e) => {
                e.stopPropagation();
                window.location.href = '/surprise/';
            });

            // Initial launch on load
            triggerCleanTooth();
            teethContainer.appendChild(cleanTooth);

            // Re-trigger every 20 seconds
            setInterval(triggerCleanTooth, 20000);
        }

        // Animate "Sheena" Name and "RDH" Badge
        if (typeof anime !== 'undefined') {
            anime({
                targets: '.hero-name, .hero-letter',
                opacity: [0, 1],
                translateY: [35, 0],
                scale: [0.85, 1],
                easing: 'easeOutBack',
                duration: 900,
                delay: 250
            });

            anime({
                targets: '.hero-badge',
                opacity: [0, 1],
                scale: [0.65, 1],
                easing: 'easeOutBack',
                duration: 800,
                delay: 1150,
                complete: function() {
                    const badge = document.querySelector('.hero-badge');
                    if (badge) badge.classList.add('active-color');
                }
            });
        }

        // Section Titles Scroll Reveal Observer (Wipes darker color overlay across title on scroll into view)
        if ('IntersectionObserver' in window) {
            const titleObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('revealed');
                    }
                });
            }, {
                rootMargin: '0px 0px -10% 0px',
                threshold: 0.15
            });

            document.querySelectorAll('.section-title, .bio-main-title, .portal-title-main, .advice-main-title, .products-main-title, .contact-main-title, .faq-banner-title, .section-title-reveal').forEach(title => {
                titleObserver.observe(title);
            });
        } else {
            document.querySelectorAll('.section-title, .bio-main-title, .portal-title-main, .advice-main-title, .products-main-title, .contact-main-title, .faq-banner-title, .section-title-reveal').forEach(title => {
                title.classList.add('revealed');
            });
        }
        const header = document.getElementById('main-header');
        if (header) {
            const handleScroll = () => {
                if (window.scrollY > 20) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            };
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        }

        // Mobile Menu Toggle
        const mobileToggle = document.querySelector('.mobile-nav-toggle');
        const navLinksList = document.getElementById('nav-links');

        if (mobileToggle && navLinksList) {
            mobileToggle.addEventListener('click', () => {
                mobileToggle.classList.toggle('active');
                navLinksList.classList.toggle('active');
            });

            // Close menu on link click
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', () => {
                    mobileToggle.classList.remove('active');
                    navLinksList.classList.remove('active');
                });
            });
        }

        // Active Nav Link on Scroll
        const sections = document.querySelectorAll('section[id]');
        const navItems = document.querySelectorAll('.nav-links a');

        window.addEventListener('scroll', () => {
            let current = '';
            const scrollPos = window.scrollY + 120; // offset for sticky header

            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                const sectionHeight = section.offsetHeight;
                if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
                    current = section.getAttribute('id');
                }
            });

            navItems.forEach(item => {
                item.classList.remove('active');
                const href = item.getAttribute('href');
                if (href === `#${current}` || href === `/#${current}`) {
                    item.classList.add('active');
                }
            });
        });

        // Patient Exam Portal Tabs
        const tabBtns = document.querySelectorAll('.portal-num-btn, .portal-tab-btn');
        const panes = document.querySelectorAll('.portal-pane');
        const topHeaders = document.querySelectorAll('.portal-top-header');
        const stageVideos = document.querySelectorAll('.portal-featured-video');

        // Ensure all stage videos start playing for seamless mobile playback
        stageVideos.forEach(vid => {
            vid.muted = true;
            vid.playsInline = true;
            const playPromise = vid.play();
            if (playPromise !== undefined) {
                playPromise.catch(() => { });
            }
        });

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetTab = btn.getAttribute('data-tab');

                // Toggle Active Tab Button
                tabBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // Toggle Active Top Header
                topHeaders.forEach(th => {
                    if (th.id === `top-header-${targetTab}`) {
                        th.classList.add('active');
                    } else {
                        th.classList.remove('active');
                    }
                });

                // Toggle Active Stage Video
                stageVideos.forEach(vid => {
                    if (vid.id === `video-${targetTab}`) {
                        vid.classList.add('active');
                        vid.play().catch(() => { });
                    } else {
                        vid.classList.remove('active');
                        vid.pause();
                    }
                });

                // Toggle Active Display Pane
                panes.forEach(pane => {
                    if (pane.id === `pane-${targetTab}`) {
                        pane.classList.add('active');
                    } else {
                        pane.classList.remove('active');
                    }
                });
            });
        });

        // Product Stack & Mobile Arrow Navigation
        const menuItems = document.querySelectorAll('.menu-item');
        const cards = document.querySelectorAll('.stack-card');
        const prevBtn = document.getElementById('product-prev-btn');
        const nextBtn = document.getElementById('product-next-btn');
        const counterEl = document.getElementById('product-counter');
        const totalCards = cards.length;
        let currentIdx = 0;

        function updateStack(activeIndex) {
            currentIdx = activeIndex;
            const isMobile = window.innerWidth <= 768;
            const isTablet = window.innerWidth <= 1024;

            const stackBaseX = isMobile ? -15 : (isTablet ? -40 : -65);
            const xOffset = isMobile ? 6 : (isTablet ? 12 : 16);
            const rotateOffset = isMobile ? 0.5 : (isTablet ? 1.5 : 2);
            const scaleOffset = 0.02;

            cards.forEach(card => {
                const index = parseInt(card.getAttribute('data-index'), 10);

                if (index < activeIndex) {
                    card.classList.remove('active');
                    card.style.zIndex = 10 - index;
                    card.style.transform = 'translate3d(-125%, 0, 0) rotate(-6deg) scale(0.9)';
                    card.style.opacity = 0;
                } else if (index === activeIndex) {
                    card.classList.add('active');
                    card.style.zIndex = 20;
                    card.style.transform = 'translate3d(0, 0, 0) rotate(0deg) scale(1)';
                    card.style.opacity = 1;
                } else {
                    card.classList.remove('active');
                    const depth = index - activeIndex;
                    const zIndexVal = 10 - index;
                    const shiftVal = stackBaseX - (depth * xOffset);
                    const rotateVal = -1 * (depth * rotateOffset);
                    const scaleVal = 1 - (depth * scaleOffset);

                    card.style.zIndex = zIndexVal;
                    card.style.transform = `translate3d(${shiftVal}px, 0, 0) rotate(${rotateVal}deg) scale(${scaleVal})`;
                    card.style.opacity = 1;
                }
            });

            // Update counter display
            if (counterEl) {
                counterEl.textContent = `${activeIndex + 1} / ${totalCards}`;
            }

            // Sync menuItems active state
            menuItems.forEach((mi, idx) => {
                if (idx === activeIndex) {
                    mi.classList.add('active');
                } else {
                    mi.classList.remove('active');
                }
            });
        }

        if (cards.length > 0) {
            updateStack(0);

            // Desktop Menu Items Hover/Click
            menuItems.forEach((item, idx) => {
                const handleSelection = () => updateStack(idx);
                item.addEventListener('mouseenter', handleSelection);
                item.addEventListener('click', handleSelection);
            });

            // Mobile Arrow Buttons
            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    const newIdx = (currentIdx - 1 + totalCards) % totalCards;
                    updateStack(newIdx);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    const newIdx = (currentIdx + 1) % totalCards;
                    updateStack(newIdx);
                });
            }
        }


        // Contact & Booking Form Submission
        const contactForm = document.getElementById('contact-form');
        if (contactForm) {
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();

                const name = contactForm.querySelector('input[type="text"]').value;
                const email = contactForm.querySelector('input[type="email"]').value;
                const category = contactForm.querySelector('select').value;
                const message = contactForm.querySelector('textarea').value;

                // Simple confirmation notification
                alert(`Thank you, ${name}! Your consultation request has been submitted. Sheena will contact you at ${email} regarding scheduling.`);
                contactForm.reset();
            });
        }

    });
</script>