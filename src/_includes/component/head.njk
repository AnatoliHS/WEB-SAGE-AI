<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "Tinker Click — Make your own apps by describing them" }}</title>

  <meta name="description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for the private alpha.' }}" />
  <meta name="keywords" content="Tinker Click, make your own apps, AI app maker, remix apps, app gallery, offline apps, creative playground, tinker app, tinker.click" />
  <meta name="author" content="Tinker Click" />
  <meta name="robots" content="{{ 'noindex, nofollow' if noindex else 'index, follow' }}" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://tinker.click{{ page.url }}" />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://tinker.click{{ page.url }}" />
  <meta property="og:title" content="{{ title or 'Tinker Click — Make your own apps by describing them' }}" />
  <meta property="og:description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for the private alpha.' }}" />
  <meta property="og:image" content="https://tinker.click/assets/tinker-wordmark-cream-400.png" />

  <!-- Twitter Card -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://tinker.click{{ page.url }}" />
  <meta property="twitter:title" content="{{ title or 'Tinker Click — Make your own apps by describing them' }}" />
  <meta property="twitter:description" content="{{ description or 'Tinker Click turns what you describe into small apps you can play, remix and share. Join the waitlist for the private alpha.' }}" />
  <meta property="twitter:image" content="https://tinker.click/assets/tinker-wordmark-cream-400.png" />

  <!-- Structured Data: SoftwareApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Tinker Click",
    "operatingSystem": "Windows, macOS, Linux",
    "description": "Tinker Click is an open-source desktop app for making focused apps, games, documents, charts and dashboards by describing them, with a public gallery to discover, remix and share them.",
    "url": "https://tinker.click"
  }
  </script>

  <!-- Flag JS early so reveal animations never hide content without it -->
  <script>document.documentElement.classList.add('js');</script>
  {% if intro %}
  <!-- Intro (component/intro.njk): plays on every load, except with reduced motion -->
  <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('has-intro');</script>
  {% endif %}

  <!-- Google Fonts: Anton (wordmark only), Geist (everything else) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css">

  <!-- Favicons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0e0e0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#eee9e2" media="(prefers-color-scheme: light)">
</head>