<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "Sage: Open-source, private & secure AI platform for teams" }}</title>

  <meta name="description" content="{{ description or 'The best open‑source alternative to proprietary AI platforms. Private by design, self‑hosted or managed. Build, deploy, and collaborate with AI agents in one calm, organized place.' }}" />
  <meta name="keywords" content="Sage, open-source AI, private AI platform, self-hosted AI, technical capital, AI agents, Startr" />
  <meta name="author" content="Sage" />
  <meta name="robots" content="{{ 'noindex, nofollow' if noindex else 'index, follow' }}" />

  <!-- Canonical URL -->
  <link rel="canonical" href="https://sage.is{{ page.url }}" />

  <!-- Open Graph / Social -->
  <meta property="og:site_name" content="Sage Is" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://sage.is{{ page.url }}" />
  <meta property="og:title" content="{{ title or 'Open-source, private & secure AI platform for teams' }}" />
  <meta property="og:description" content="{{ description or 'The best open‑source alternative to proprietary AI platforms. Private by design, self‑hosted or managed. Build, deploy, and collaborate with AI agents in one place.' }}" />
  <meta property="og:image" content="/assets/images/opengraph/sage.png" />

  <!-- Twitter Card -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://sage.is{{ page.url }}" />
  <meta property="twitter:title" content="{{ title or 'Open-source AI platform for teams' }}" />
  <meta property="twitter:description" content="{{ description or 'The best open‑source alternative to proprietary AI platforms. Private, secure, and self‑hostable.' }}" />
  <meta property="twitter:image" content="/assets/images/opengraph/sage.png" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Sage",
    "operatingSystem": "Web, Cloud, Self-hosted",
    "description": "The best open‑source alternative to proprietary AI platforms. Private by design, self‑hosted or managed. Build, deploy, and collaborate with AI agents in one calm, organized place.",
    "url": "https://sage.is"
  }
  </script>

  <!-- Flag JS early so reveal animations never hide content without it -->
  <script>document.documentElement.classList.add('js');</script>
  <!-- Colour theme (style.css, COLOUR THEMES): Home (Paper, with a Forest hero); ?theme=<name> tries
       another for the comparison page (concepts/palettes.njk), ?theme=violet the original. ?intro=0 skips the intro -->
  <script>(function () {
    var q = new URLSearchParams(location.search), root = document.documentElement;
    root.dataset.theme = q.get('theme') || 'home';
    // Hero depth (assets/js/hero-depth.js): the page's heroDepth, or ?depth=<name> (none: off)
    var depth = q.get('depth') || '{{ heroDepth or "" }}';
    if (depth && depth !== 'none') root.dataset.heroDepth = depth;
    // Hero burn (assets/js/hero-burn.js): the page's heroBurn, or ?burn=<name> (none: off)
    var burn = q.get('burn') || '{{ heroBurn or "" }}';
    if (burn && burn !== 'none') root.dataset.heroBurn = burn;
  })();</script>
  {% if intro %}
  <!-- Intro (component/intro.njk): plays on every load, except with reduced motion -->
  <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !/[?&]intro=0/.test(location.search)) document.documentElement.classList.add('has-intro');</script>
  {% endif %}

  <!-- Google Fonts: Anton (wordmark only), Geist (everything else) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Geist:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">

  <!-- Favicons -->
  <link rel="icon" href="/assets/images/general/sage.webp" type="image/webp">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/assets/images/general/sage.webp">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#1d2516">
</head>