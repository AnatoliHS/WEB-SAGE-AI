<!DOCTYPE html>
<html lang="en">
  {% include "component/head.njk" %}
  <body class="tinker-app">
    {% if intro %}{% include "component/intro.njk" %}{% endif %}
    {% include "component/navbar.njk" %}
    
    <main id="main-content">
      {{ content | safe }}
    </main>

    {% include "component/footer.njk" %}
    {% if intro %}
    <script src="/assets/js/intros/core.js?v={{ build.version }}"></script>
    {% set variant = introVariant or 'horizon' %}
    {% set field = promptField or 'stars' %}
    {% if variant == 'horizon' or (variant == 'prompt' and field == 'stars') %}<script src="/assets/js/intros/starfield.js?v={{ build.version }}"></script>{% endif %}
    {# What moves around the Prompt intro's input: the page's promptField (intros/fields/) #}
    {% if variant == 'prompt' %}<script src="/assets/js/intros/fields/{{ field }}.js?v={{ build.version }}"></script>{% endif %}
    <script src="/assets/js/intros/{{ variant }}.js?v={{ build.version }}"></script>
    {% endif %}
    {% include "component/scripts.njk" %}
    {% if intro %}
    <script src="/assets/js/hero-depth.js?v={{ build.version }}"></script>
    <script src="/assets/js/hero-burn.js?v={{ build.version }}"></script>
    {% endif %}
    {% if heroSphere %}
    <script src="/assets/js/hero-stage.js?v={{ build.version }}"></script>
    <script src="/assets/js/sphere.js?v={{ build.version }}"></script>
    {% endif %}
  </body>
</html>
