        <div class="ln-actions">
          <a class="ln-cta" href="https://sage.is/programs#packages"><span class="ln-cta-key"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 17 5-5-5-5M13 17l5-5-5-5"/></svg></span>Start a project</a>
          <a class="ln-link" href="https://github.com/Sage-is/AI-UI" target="_blank" rel="noopener">Star on GitHub</a>
