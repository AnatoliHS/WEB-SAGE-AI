  <div class="container">
    <div class="ln-cap"><p>{{ o.tag }}</p><p><b>{{ o.name }}</b>{{ o.desc }}</p></div>
  </div>
  <div class="ln-stage">
    <div class="container ln-top">
      <h2 class="ln-title ln-in"><span>Your next</span> AI breakthrough.</h2>
      <div class="ln-in">
