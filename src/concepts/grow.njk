---
layout: policy.njk
title: "Section 01 layouts: Sage"
description: Five layouts for the homepage's "Open-Source AI & Technical Capital" section, side by side.
noindex: true
permalink: /concepts/grow/
# The section's copy, exactly as on the homepage (index.html), shared by every layout below
grow:
  label: "Open-Source AI &amp; Technical Capital"
  title: 'Grow your ideas with <span class="text-accent">Sage.is</span>'
  subtitle: "We build <u>Open-source AI solutions</u> and provide <u>Technical Capital</u> to align with your business goals."
  lede: "Work with our <u>powerful AI</u> and <u>human experts</u> to develop <u>your bold vision</u>, no matter the challenge. Our experts embed with your team to deploy and customize the <u>Sage.is AI engine.</u>"
  sub: "Our open-source tech stack and hands-on approach get you from idea to impact, fast. Hands-on technical support, OSS collaboration, and community-driven tools. No lock-in. Your success, our open ecosystem."
  pillars:
    - icon: layers
      title: "Open-Source AI Engine"
      text: "Deploy and customize the core Sage.is AI engine. Full ownership of your models, workflows, and data with zero vendor lock-in."
      tag: "100% Data Sovereignty"
    - icon: people
      title: "Embedded Technical Capital"
      text: "Our elite engineering experts embed directly with your team, providing hands-on OSS collaboration and deep AI/ML technical leverage."
      tag: "Hands-On Co-Creation"
    - icon: bolt
      title: "Idea to Impact, Fast"
      text: "Work with our powerful AI and human specialists to develop your bold vision. From concept to production impact in record time."
      tag: "Zero Debt &bull; Fast Launch"
layouts:
  - slug: index
    name: Index
    note: "The pillars become a numbered index, one full-width row each: a big outlined numeral, the title, its text and its tag across the grid. The statement opens the section, straight under the title. Reads like a table of contents; the fastest to scan."
  - slug: sticky
    name: Sticky split
    note: "The heading, subtitle and closing line stay pinned on the left while the pillars scroll past on the right, each with room to breathe and a large icon; the statement lands at the end of the column. Turns the section into a short read."
  - slug: manifesto
    name: Manifesto
    note: "The statement leads, set large across the page, its underlined phrases lit in the brand gradient. The title and subtitle sit small above it; the pillars run underneath as three columns split by vertical hairlines. The most confident; best if the statement is the message."
  - slug: staircase
    name: Staircase
    note: "The pillars climb in a diagonal, each a step lower than the last, joined by a line that runs from idea to impact. A large title and the subtitle hold the left; the statement closes at the bottom right. The most graphic; tells a progression."
  - slug: selector
    name: Selector
    note: "The three pillar titles become a large list you can point at (it moves through them on its own until you do); the chosen one's icon, text and tag show on the right with a soft glow. Interactive, compact, and keeps the page short."
  - slug: manifesto-staircase
    name: Manifesto + Staircase
    note: "On the homepage now. The top of Manifesto (the title small, the subtitle across from it, the statement large with its underlined phrases in the gradient) over the pillars of Staircase, stepping down a line from idea to impact. Staircase's own closing statement is dropped, since the statement now leads."
---
{% macro icon(name, size = 28) %}
{%- if name == "layers" -%}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
{%- elif name == "people" -%}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
{%- else -%}<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
{%- endif -%}
{% endmacro %}
{% set g = grow %}

<style>
  /* ---------- Page chrome ---------- */
  .gx-head { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); padding-top: 20px; border-top: 1px solid var(--line); }
  .gx-head > div { grid-column: 2 / -1; }
  .gx-head h1 { font-size: clamp(2.5rem, 5vw, 5.5rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; }
  .gx-head p { margin-top: 20px; max-width: 60ch; font-size: clamp(1.0625rem, 1.2vw, 1.375rem); line-height: 1.55; color: var(--ink-2); }
  .gx-jump { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: clamp(40px, 5vw, 72px); padding: 16px 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); list-style: none; font-size: 0.875rem; }
  .gx-jump a { color: var(--ink-2); transition: color 0.2s; }
  .gx-jump a:hover { color: var(--ink); }
  .gx-jump b { margin-right: 6px; font-weight: 500; color: var(--accent-soft); }
  .gx-option { padding: clamp(56px, 7vw, 112px) 0 clamp(72px, 9vw, 144px); border-bottom: 1px solid var(--line); scroll-margin-top: 56px; }
  .gx-about { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px var(--gutter); margin-bottom: clamp(48px, 6vw, 96px); padding: 18px 0; border-block: 1px dashed color-mix(in srgb, var(--accent-soft) 45%, transparent); }
  .gx-about h2 { display: flex; gap: 14px; align-items: baseline; font-size: clamp(1.25rem, 1.6vw, 1.75rem); font-weight: 500; letter-spacing: -0.03em; }
  .gx-about h2 b { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.12em; color: var(--accent-soft); }
  .gx-about p { grid-column: 2 / -1; max-width: 72ch; font-size: 0.9375rem; line-height: 1.6; color: var(--muted); }
  /* The preview itself: a section of the homepage, glow and all */
  .gx-demo { position: relative; isolation: isolate; }
  .gx-demo .ambient-glow { opacity: 0.12; }

  /* Shared bits */
  .gx-tag { display: inline-flex; align-items: center; gap: 10px; font-size: clamp(0.8125rem, 0.85vw, 0.9375rem); font-weight: 500; color: var(--muted); }
  .gx-tag::before { content: ""; flex: none; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .gx-icon { color: var(--accent-soft); }

  /* ---------- 1. Index ---------- */
  .g1 .statement { margin-top: clamp(40px, 5vw, 72px); }
  .g1-rows { list-style: none; margin-top: clamp(72px, 9vw, 136px); border-top: 1px solid var(--line); }
  .g1-row { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px var(--gutter); align-items: baseline; padding: clamp(28px, 3vw, 48px) 0; border-bottom: 1px solid var(--line); }
  .g1-row::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: var(--accent-gradient); transform: scaleX(0); transform-origin: left; transition: transform 0.9s var(--ease); }
  .g1-row:hover::after { transform: scaleX(1); }
  .g1-num { font-family: var(--font-display); font-size: clamp(3.5rem, 6vw, 7rem); line-height: 0.8; color: transparent; -webkit-text-stroke: 1.5px rgba(238, 233, 226, 0.26); transition: -webkit-text-stroke-color 0.4s; }
  .g1-row:hover .g1-num { -webkit-text-stroke-color: var(--accent-soft); }
  .g1-main { grid-column: 2 / span 2; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 12px var(--gutter); align-items: baseline; }
  .g1-main h3 { font-size: clamp(1.5rem, 2.2vw, 2.5rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; }
  .g1-main p { font-size: clamp(1rem, 1.05vw, 1.2rem); line-height: 1.6; color: var(--ink-2); }
  .g1-row .gx-tag { justify-self: end; }
  @media (max-width: 860px) {
    .g1-row { grid-template-columns: auto 1fr; }
    .g1-main { grid-column: 2; grid-template-columns: 1fr; }
    .g1-row .gx-tag { grid-column: 2; justify-self: start; }
  }

  /* ---------- 2. Sticky split ---------- */
  .g2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 48px clamp(40px, 6vw, 120px); align-items: start; padding-top: 20px; border-top: 1px solid var(--line); }
  .g2-side { position: sticky; top: calc(56px + 32px); }
  .g2-side .section-title { margin-top: clamp(24px, 2.6vw, 40px); font-size: clamp(2rem, 3.6vw, 4.5rem); }
  .g2-side .statement-sub { margin-top: clamp(28px, 3vw, 48px); max-width: 44ch; font-size: clamp(0.9375rem, 1vw, 1.125rem); }
  .g2-list { list-style: none; }
  .g2-item { display: grid; grid-template-columns: auto 1fr; gap: 10px clamp(24px, 2.6vw, 44px); padding: clamp(40px, 5vw, 80px) 0; border-bottom: 1px solid var(--line); }
  .g2-item:first-child { padding-top: 0; }
  .g2-item .gx-icon { grid-row: span 3; padding-top: 6px; }
  .g2-item h3 { font-size: clamp(1.75rem, 2.8vw, 3.25rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.04em; }
  .g2-item p { max-width: 44ch; font-size: clamp(1.0625rem, 1.2vw, 1.375rem); line-height: 1.6; color: var(--ink-2); }
  .g2-item .gx-tag { margin-top: 8px; }
  .g2-item:nth-child(2) .gx-tag { color: var(--accent-soft); }
  .g2-close { padding-top: clamp(40px, 5vw, 80px); font-size: clamp(1.5rem, 2.4vw, 2.75rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.035em; }
  @media (max-width: 860px) {
    .g2 { grid-template-columns: 1fr; }
    .g2-side { position: static; }
  }

  /* ---------- 3. Manifesto ---------- */
  .g3-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 16px var(--gutter); padding-top: 20px; border-top: 1px solid var(--line); }
  .g3-top .section-title { font-size: clamp(1.5rem, 2.2vw, 2.5rem); }
  .g3-top .section-subtitle { margin: 0; max-width: 46ch; font-size: clamp(1rem, 1.15vw, 1.3rem); text-align: right; }
  .g3-lede { margin-top: clamp(56px, 7vw, 120px); font-size: clamp(2rem, 5vw, 6.25rem); font-weight: 500; line-height: 1.04; letter-spacing: -0.05em; text-wrap: balance; }
  .g3-lede u { text-decoration: none; background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .g3-sub { max-width: 60ch; margin-top: clamp(28px, 3vw, 48px); margin-left: auto; font-size: clamp(1rem, 1.15vw, 1.35rem); line-height: 1.6; color: var(--ink-2); }
  .g3-cols { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(72px, 9vw, 144px); }
  .g3-col { display: flex; flex-direction: column; gap: 14px; padding: 0 clamp(20px, 2.6vw, 48px); border-left: 1px solid var(--line); }
  .g3-col:first-child { padding-left: 0; border-left: 0; }
  .g3-col .gx-icon { margin-bottom: clamp(20px, 2.4vw, 40px); }
  .g3-col h3 { font-size: clamp(1.25rem, 1.5vw, 1.75rem); font-weight: 500; letter-spacing: -0.03em; }
  .g3-col p { font-size: clamp(0.9375rem, 1vw, 1.125rem); line-height: 1.6; color: var(--ink-2); }
  .g3-col .gx-tag { margin-top: auto; padding-top: 12px; }
  @media (max-width: 860px) {
    .g3-cols { grid-template-columns: 1fr; gap: 40px; }
    .g3-col { padding: 0; border-left: 0; }
    .g3-top .section-subtitle { text-align: left; }
  }

  /* ---------- 4. Staircase ---------- */
  .g4 { padding-top: 20px; border-top: 1px solid var(--line); }
  .g4-head { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); align-items: end; }
  .g4-head .section-title { grid-column: 1 / span 2; margin-top: clamp(24px, 2.6vw, 40px); font-size: clamp(2.5rem, 5vw, 6rem); line-height: 0.98; }
  .g4-head .section-subtitle { grid-column: 3 / -1; }
  .g4-stage { position: relative; margin-top: clamp(72px, 9vw, 140px); padding-bottom: clamp(140px, 16vw, 280px); }
  .g4-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 var(--gutter); list-style: none; }
  /* The line the steps climb down, from idea to impact: its three levels (0, 50%, 100% of its
     height) are the three steps' drops, so it runs through each step's dot */
  .g4-path { position: absolute; left: 0; top: 0; width: 100%; height: clamp(140px, 16vw, 280px); overflow: visible; pointer-events: none; }
  .g4-step { position: relative; padding-top: 28px; }
  .g4-step:nth-child(2) { transform: translateY(clamp(70px, 8vw, 140px)); }
  .g4-step:nth-child(3) { transform: translateY(clamp(140px, 16vw, 280px)); }
  .g4-step::before { content: ""; position: absolute; left: 0; top: -4px; width: 9px; height: 9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 6px var(--bg); }
  .g4-step:nth-child(3)::before { background: #971aff; box-shadow: 0 0 0 6px var(--bg), 0 0 18px #971aff; }
  .g4-step .gx-icon { display: block; margin-bottom: 20px; }
  .g4-step h3 { font-size: clamp(1.375rem, 1.8vw, 2.125rem); font-weight: 500; letter-spacing: -0.03em; }
  .g4-step p { margin-top: 12px; max-width: 34ch; font-size: clamp(1rem, 1.05vw, 1.2rem); line-height: 1.6; color: var(--ink-2); }
  .g4-step .gx-tag { margin-top: 20px; }
  .g4-close { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); margin-top: clamp(40px, 5vw, 80px); }
  .g4-close .statement-lede { grid-column: 2 / -1; }
  .g4-close .statement-sub { grid-column: 2 / span 2; }
  @media (max-width: 860px) {
    .g4-head, .g4-close { grid-template-columns: 1fr; }
    .g4-head > *, .g4-close > * { grid-column: 1 !important; }
    .g4-stage { padding-bottom: 0; }
    .g4-steps { grid-template-columns: 1fr; gap: 48px; }
    .g4-step:nth-child(n) { transform: none; }
    .g4-path { display: none; }
  }

  /* ---------- 5. Selector ---------- */
  .g5 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px var(--gutter); }
  .g5-head { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); padding-top: 20px; border-top: 1px solid var(--line); }
  .g5-head > div { grid-column: 2 / -1; }
  .g5-list { grid-column: 1 / span 2; margin-top: clamp(40px, 5vw, 80px); list-style: none; border-top: 1px solid var(--line); }
  .g5-list button { display: flex; align-items: baseline; gap: 20px; width: 100%; padding: clamp(18px, 2vw, 30px) 0; border-bottom: 1px solid var(--line); text-align: left; font-size: clamp(1.75rem, 3.2vw, 3.75rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.045em; color: var(--muted); transition: color 0.4s ease, padding 0.6s var(--ease); }
  .g5-list button span { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.1em; color: inherit; }
  .g5-list button:hover { color: var(--ink-2); }
  .g5-list button[aria-selected="true"] { color: var(--ink); padding-left: clamp(8px, 1vw, 20px); }
  .g5-list button[aria-selected="true"] span { color: var(--accent-soft); }
  .g5-panel { grid-column: 3 / -1; position: relative; margin-top: clamp(40px, 5vw, 80px); min-height: 340px; }
  .g5-panel::before { content: ""; position: absolute; inset: -10% -10% auto auto; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(110, 50, 255, 0.28), transparent); filter: blur(30px); z-index: -1; }
  .g5-pane { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 18px; padding-top: clamp(18px, 2vw, 30px); opacity: 0; transform: translateY(14px); transition: opacity 0.5s ease, transform 0.7s var(--ease); pointer-events: none; }
  .g5-pane.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .g5-pane .gx-icon { margin-bottom: 12px; }
  .g5-pane p { max-width: 40ch; font-size: clamp(1.25rem, 1.7vw, 2rem); line-height: 1.35; letter-spacing: -0.025em; color: var(--ink); }
  .g5-pane .gx-tag { color: var(--accent-soft); }
  .g5-timer { display: block; height: 1px; margin-top: auto; overflow: hidden; background: var(--line); }
  .g5-timer i { display: block; height: 100%; background: var(--accent-gradient); transform: scaleX(0); transform-origin: left; }
  .g5 .statement { grid-column: 1 / -1; margin-top: clamp(64px, 8vw, 128px); }
  @media (max-width: 860px) {
    .g5, .g5-head { grid-template-columns: 1fr; }
    .g5-head > div, .g5-list, .g5-panel { grid-column: 1; }
  }
</style>

<header class="gx-head">
  <p class="section-label"><span class="index-num">00</span>Section 01 layouts</p>
  <div>
    <h1>Five ways to grow, and the pick.</h1>
    <p>Five layouts for the homepage's "Open-Source AI &amp; Technical Capital" section, each with exactly the same copy, built from the site's own type, rules and colours, and none of them in boxes. Each is shown full width, as it would sit on the page.</p>
  </div>
</header>

<ul class="gx-jump">
  {% for l in layouts %}<li><a href="#{{ l.slug }}"><b>0{{ loop.index }}</b>{{ l.name }}</a></li>{% endfor %}
</ul>

{# ===================== 1. INDEX ===================== #}
<section class="gx-option" id="index">
  <div class="gx-about"><h2><b>01</b>{{ layouts[0].name }}</h2><p>{{ layouts[0].note }}</p></div>
  <div class="gx-demo g1">
    <div class="ambient-glow ambient-glow--center" aria-hidden="true"></div>
    <header class="section-head">
      <p class="section-label"><span class="index-num">01</span>{{ g.label | safe }}</p>
      <div>
        <h2 class="section-title">{{ g.title | safe }}</h2>
        <p class="section-subtitle">{{ g.subtitle | safe }}</p>
      </div>
    </header>
    <div class="statement">
      <p class="statement-lede">{{ g.lede | safe }}</p>
      <p class="statement-sub">{{ g.sub | safe }}</p>
    </div>
    <ol class="g1-rows">
      {% for p in g.pillars %}
      <li class="g1-row">
        <span class="g1-num" aria-hidden="true">0{{ loop.index }}</span>
        <div class="g1-main">
          <h3>{{ p.title }}</h3>
          <p>{{ p.text }}</p>
        </div>
        <p class="gx-tag">{{ p.tag | safe }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ===================== 2. STICKY SPLIT ===================== #}
<section class="gx-option" id="sticky">
  <div class="gx-about"><h2><b>02</b>{{ layouts[1].name }}</h2><p>{{ layouts[1].note }}</p></div>
  <div class="gx-demo g2">
    <div class="ambient-glow ambient-glow--left" aria-hidden="true"></div>
    <div class="g2-side">
      <p class="section-label"><span class="index-num">01</span>{{ g.label | safe }}</p>
      <h2 class="section-title">{{ g.title | safe }}</h2>
      <p class="section-subtitle">{{ g.subtitle | safe }}</p>
      <p class="statement-sub">{{ g.sub | safe }}</p>
    </div>
    <div>
      <ul class="g2-list">
        {% for p in g.pillars %}
        <li class="g2-item">
          <span class="gx-icon">{{ icon(p.icon, 40) }}</span>
          <h3>{{ p.title }}</h3>
          <p>{{ p.text }}</p>
          <p class="gx-tag">{{ p.tag | safe }}</p>
        </li>
        {% endfor %}
      </ul>
      <p class="g2-close">{{ g.lede | safe }}</p>
    </div>
  </div>
</section>

{# ===================== 3. MANIFESTO ===================== #}
<section class="gx-option" id="manifesto">
  <div class="gx-about"><h2><b>03</b>{{ layouts[2].name }}</h2><p>{{ layouts[2].note }}</p></div>
  <div class="gx-demo g3">
    <div class="ambient-glow ambient-glow--center" aria-hidden="true"></div>
    <div class="g3-top">
      <div>
        <p class="section-label"><span class="index-num">01</span>{{ g.label | safe }}</p>
        <h2 class="section-title" style="margin-top: 14px;">{{ g.title | safe }}</h2>
      </div>
      <p class="section-subtitle">{{ g.subtitle | safe }}</p>
    </div>
    <p class="g3-lede">{{ g.lede | safe }}</p>
    <p class="g3-sub">{{ g.sub | safe }}</p>
    <div class="g3-cols">
      {% for p in g.pillars %}
      <article class="g3-col">
        <span class="gx-icon">{{ icon(p.icon, 32) }}</span>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
        <p class="gx-tag">{{ p.tag | safe }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ===================== 4. STAIRCASE ===================== #}
<section class="gx-option" id="staircase">
  <div class="gx-about"><h2><b>04</b>{{ layouts[3].name }}</h2><p>{{ layouts[3].note }}</p></div>
  <div class="gx-demo g4">
    <div class="ambient-glow ambient-glow--right" aria-hidden="true"></div>
    <div class="g4-head">
      <p class="section-label" style="grid-column: 1 / -1;"><span class="index-num">01</span>{{ g.label | safe }}</p>
      <h2 class="section-title">{{ g.title | safe }}</h2>
      <p class="section-subtitle">{{ g.subtitle | safe }}</p>
    </div>
    <div class="g4-stage">
      <svg class="g4-path" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="g4-grad" x1="0" x2="1"><stop offset="0" stop-color="rgba(238,233,226,0.25)"/><stop offset="1" stop-color="#971aff"/></linearGradient></defs>
        <path d="M0 0 L100 0 L100 50 L200 50 L200 100 L300 100" fill="none" stroke="url(#g4-grad)" stroke-width="1" vector-effect="non-scaling-stroke"/>
      </svg>
      <ol class="g4-steps">
      {% for p in g.pillars %}
      <li class="g4-step">
        <span class="gx-icon">{{ icon(p.icon, 30) }}</span>
        <h3>{{ p.title }}</h3>
        <p>{{ p.text }}</p>
        <p class="gx-tag">{{ p.tag | safe }}</p>
      </li>
      {% endfor %}
      </ol>
    </div>
    <div class="g4-close">
      <p class="statement-lede">{{ g.lede | safe }}</p>
      <p class="statement-sub">{{ g.sub | safe }}</p>
    </div>
  </div>
</section>

{# ===================== 5. SELECTOR ===================== #}
<section class="gx-option" id="selector">
  <div class="gx-about"><h2><b>05</b>{{ layouts[4].name }}</h2><p>{{ layouts[4].note }}</p></div>
  <div class="gx-demo g5" data-g5>
    <div class="ambient-glow ambient-glow--center" aria-hidden="true"></div>
    <header class="g5-head">
      <p class="section-label"><span class="index-num">01</span>{{ g.label | safe }}</p>
      <div>
        <h2 class="section-title">{{ g.title | safe }}</h2>
        <p class="section-subtitle">{{ g.subtitle | safe }}</p>
      </div>
    </header>
    <ul class="g5-list" role="tablist" aria-label="What Sage brings">
      {% for p in g.pillars %}
      <li><button type="button" role="tab" id="g5-tab-{{ loop.index }}" aria-controls="g5-pane-{{ loop.index }}" aria-selected="{{ 'true' if loop.first else 'false' }}"><span>0{{ loop.index }}</span>{{ p.title }}</button></li>
      {% endfor %}
    </ul>
    <div class="g5-panel">
      {% for p in g.pillars %}
      <div class="g5-pane{{ ' is-on' if loop.first }}" id="g5-pane-{{ loop.index }}" role="tabpanel" aria-labelledby="g5-tab-{{ loop.index }}">
        <span class="gx-icon">{{ icon(p.icon, 44) }}</span>
        <p>{{ p.text }}</p>
        <p class="gx-tag">{{ p.tag | safe }}</p>
        <span class="g5-timer" aria-hidden="true"><i></i></span>
      </div>
      {% endfor %}
    </div>
    <div class="statement">
      <p class="statement-lede">{{ g.lede | safe }}</p>
      <p class="statement-sub">{{ g.sub | safe }}</p>
    </div>
  </div>
</section>

{# ===================== 6. MANIFESTO + STAIRCASE (the homepage's own markup and classes) ===================== #}
<section class="gx-option" id="manifesto-staircase">
  <div class="gx-about"><h2><b>06</b>{{ layouts[5].name }}</h2><p>{{ layouts[5].note }}</p></div>
  <div class="gx-demo">
    <div class="ambient-glow ambient-glow--center" aria-hidden="true"></div>
    <header class="grow-top">
      <div>
        <p class="section-label"><span class="index-num">01</span>{{ g.label | safe }}</p>
        <h2 class="section-title grow-title">{{ g.title | safe }}</h2>
      </div>
      <p class="section-subtitle grow-subtitle">{{ g.subtitle | safe }}</p>
    </header>
    <p class="grow-lede">{{ g.lede | safe }}</p>
    <p class="grow-sub">{{ g.sub | safe }}</p>
    <div class="grow-stairs">
      <svg class="grow-path" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true">
        <defs><linearGradient id="gx6-grad" x1="0" x2="1"><stop offset="0" stop-color="rgba(238,233,226,0.25)"/><stop offset="1" stop-color="#971aff"/></linearGradient></defs>
        <path d="M0 0 L100 0 L100 50 L200 50 L200 100 L300 100" fill="none" stroke="url(#gx6-grad)" stroke-width="1" vector-effect="non-scaling-stroke"/>
      </svg>
      <ol class="grow-steps">
        {% for p in g.pillars %}
        <li class="grow-step">
          <span class="grow-icon">{{ icon(p.icon, 30) }}</span>
          <h3>{{ p.title }}</h3>
          <p>{{ p.text }}</p>
          <p class="grow-tag">{{ p.tag | safe }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

<script>
// 5. Selector: moves through the pillars on its own (the line under the text fills as it waits)
// until someone points at one, then stays on their choice
(() => {
  const root = document.querySelector('[data-g5]');
  if (!root) return;
  const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
  const panes = Array.from(root.querySelectorAll('.g5-pane'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEP = 4200;
  let current = 0, start = performance.now(), auto = !reduced;
  const show = (i) => {
    current = i;
    start = performance.now();
    tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
    panes.forEach((p, j) => p.classList.toggle('is-on', j === i));
  };
  tabs.forEach((t, i) => {
    const pick = () => { auto = false; show(i); panes.forEach((p) => (p.querySelector('.g5-timer i').style.transform = 'scaleX(0)')); };
    t.addEventListener('click', pick);
    t.addEventListener('mouseenter', pick);
  });
  const tick = (now) => {
    requestAnimationFrame(tick);
    if (!auto) return;
    const k = Math.min(1, (now - start) / STEP);
    panes[current].querySelector('.g5-timer i').style.transform = `scaleX(${k})`;
    if (k >= 1) show((current + 1) % tabs.length);
  };
  requestAnimationFrame(tick);
})();
</script>
