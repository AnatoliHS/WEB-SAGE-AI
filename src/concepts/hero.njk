<style>
  .hx-intro { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); padding: 20px 0 40px; border-top: 1px solid var(--line); }
  .hx-intro > div { grid-column: 2 / -1; }
  .hx-intro h1 { font-size: clamp(2.5rem, 5vw, 5.5rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; }
  .hx-intro p { margin-top: 20px; max-width: 60ch; font-size: clamp(1.0625rem, 1.2vw, 1.375rem); line-height: 1.55; color: var(--ink-2); }
  .hx-jump { position: sticky; top: 0; z-index: 30; display: flex; flex-wrap: wrap; gap: 4px 22px; padding: 14px 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 90%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); list-style: none; font-size: 0.875rem; }
  .hx-jump a { color: var(--ink-2); }
  .hx-jump b { margin-right: 6px; font-weight: 500; color: var(--accent-soft); }

  /* Each option: a caption on the paper, then the hero at full width on the night ground */
  .hx-option { margin-inline: calc(50% - 50vw); padding: clamp(64px, 8vw, 120px) 0 0; scroll-margin-top: 50px; }
  .hx-cap { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px var(--gutter); margin-bottom: clamp(32px, 4vw, 56px); padding: 18px 20px; border-radius: 14px; background: color-mix(in srgb, var(--accent-2) 7%, transparent); }
  .hx-cap > p:first-child { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-soft); }
  .hx-cap > p:last-child { grid-column: 2 / -1; font-size: 1rem; line-height: 1.6; color: var(--ink-2); }
  .hx-cap b { display: block; margin-bottom: 4px; font-size: 1.375rem; font-weight: 500; letter-spacing: -0.03em; color: var(--ink); }

  /* The hero's own tokens (the Purple palette's hero), so every option sits on the real ground */
  .hx-stage {
    color-scheme: dark;
    --bg: #161028; --bg-raised: #1f1736; --ink: #f1eefa; --ink-2: #c6c0d8; --muted: #8d86a3;
    --line: rgba(241, 238, 250, 0.12); --accent: #971aff; --accent-2: #971aff;
    --accent-gradient: linear-gradient(135deg, #302aff 0%, #971aff 100%); --accent-soft: #8f86ff;
    --on-accent: #fff; --on-ink: #0e0b18;
    position: relative; display: flex; flex-direction: column; min-height: min(100svh, 980px); overflow: hidden; isolation: isolate;
    padding: clamp(28px, 4vw, 56px) 0;
    background: radial-gradient(circle farthest-corner at 50% 50%, #18122c 0%, #0e0b1a 55%, #06050c 100%);
    color: var(--ink);
  }
  .hx-stage > .container { position: relative; display: flex; flex: 1; flex-direction: column; }
  .hx-glow { position: absolute; z-index: -1; border-radius: 50%; filter: blur(80px); pointer-events: none; }
  .hx-title { font-weight: 500; letter-spacing: -0.05em; line-height: 0.98; text-wrap: balance; }
  .hx-lede { font-size: clamp(1.0625rem, 1.2vw, 1.375rem); line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .hx-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; }
  .hx-link { display: inline-flex; align-items: center; gap: 8px; font-size: 0.9375rem; font-weight: 500; color: var(--ink); }
  .hx-link svg { transition: transform 0.3s var(--ease); }
  .hx-link:hover svg { transform: translateX(3px); }
  .hx-link:hover { color: var(--accent-soft); }
  .hx-pill { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 8px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.8125rem; color: var(--ink-2); background: rgba(255, 255, 255, 0.03); }
  .hx-pill i { padding: 2px 8px; border-radius: 999px; font-style: normal; font-weight: 500; color: var(--on-accent); background: var(--accent-gradient); }
  .hx-label { font-size: 0.75rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

  /* Shared entrance: each child rises in, one after another, when the hero scrolls into view */
  .hx-in > * { opacity: 0; translate: 0 18px; transition: opacity 0.8s ease, translate 1s var(--ease); }
  .hx-in.is-on > * { opacity: 1; translate: 0 0; }
  .hx-in.is-on > :nth-child(2) { transition-delay: 0.08s; }
  .hx-in.is-on > :nth-child(3) { transition-delay: 0.16s; }
  .hx-in.is-on > :nth-child(4) { transition-delay: 0.24s; }
  .hx-in.is-on > :nth-child(5) { transition-delay: 0.32s; }

  /* 01 Centred statement */
  .hx-1 .hx-glow { left: 50%; top: 46%; width: min(760px, 90vw); height: 360px; translate: -50% -50%; background: radial-gradient(closest-side, rgba(110, 50, 255, 0.35), transparent); }
  .hx-1-body { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
  .hx-1 .hx-title { margin-top: 28px; font-size: clamp(3rem, 8.4vw, 9.5rem); }
  .hx-1 .hx-lede { max-width: 46ch; margin: 28px auto 0; }
  .hx-1 .hx-actions { justify-content: center; margin-top: 40px; }
  .hx-1-foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 36px; padding-top: 22px; border-top: 1px solid var(--line); font-size: 0.875rem; color: var(--muted); }
  .hx-1-foot a { color: var(--ink-2); }
  .hx-1-foot a:hover { color: var(--ink); }

  /* 02 Split, with the product */
  .hx-2 .hx-glow { right: -10%; top: 10%; width: 60vw; height: 60vw; max-width: 900px; max-height: 900px; background: radial-gradient(closest-side, rgba(110, 50, 255, 0.22), transparent); }
  .hx-2-body { display: grid; flex: 1; grid-template-columns: 5fr 6fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .hx-2 .hx-title { margin-top: 24px; font-size: clamp(2.75rem, 5.6vw, 6.5rem); }
  .hx-2 .hx-lede { max-width: 40ch; margin-top: 24px; }
  .hx-2 .hx-actions { margin-top: 36px; }
  .hx-2-proof { display: flex; align-items: center; gap: 14px; margin-top: 48px; font-size: 0.875rem; color: var(--muted); }
  .hx-2-faces { display: flex; }
  .hx-2-faces i { width: 28px; height: 28px; margin-left: -8px; border: 2px solid #110d20; border-radius: 50%; background: linear-gradient(135deg, #302aff, #971aff); }
  .hx-2-faces i:first-child { margin-left: 0; background: linear-gradient(135deg, #8f86ff, #302aff); }
  .hx-2-faces i:nth-child(3) { background: linear-gradient(135deg, #c6c0d8, #8f86ff); }
  .hx-2-faces i:nth-child(4) { background: linear-gradient(135deg, #971aff, #ff8a5c); }
  .hx-win { border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)); box-shadow: 0 40px 120px -30px rgba(80, 30, 200, 0.45); overflow: hidden; }
  .hx-win-bar { display: flex; align-items: center; gap: 7px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .hx-win-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
  .hx-win-bar span { margin-left: auto; font-size: 0.75rem; color: var(--muted); }
  .hx-win-body { display: flex; flex-direction: column; gap: 14px; min-height: 300px; padding: 24px; }
  .hx-msg { max-width: 82%; padding: 12px 16px; border-radius: 14px; font-size: 0.9375rem; line-height: 1.5; opacity: 0; translate: 0 8px; transition: opacity 0.5s ease, translate 0.6s var(--ease); }
  .hx-msg.is-on { opacity: 1; translate: 0 0; }
  .hx-msg.you { align-self: flex-end; color: var(--ink); background: rgba(151, 26, 255, 0.18); }
  .hx-msg.sage { color: var(--ink-2); background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line); }
  .hx-msg.sage b { font-weight: 500; color: var(--ink); }
  .hx-win-input { display: flex; align-items: center; gap: 10px; margin: 0 24px 24px; padding: 12px 12px 12px 16px; border: 1px solid var(--line); border-radius: 12px; font-size: 0.9375rem; color: var(--muted); }
  .hx-win-input span { flex: 1; }
  .hx-win-input span::after { content: ""; display: inline-block; width: 1px; height: 1.1em; margin-left: 2px; vertical-align: -0.2em; background: var(--ink); animation: hx-caret 1s steps(1) infinite; }
  .hx-win-input b { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; color: #fff; background: var(--accent-gradient); }
  @keyframes hx-caret { 50% { opacity: 0; } }

  /* 03 Editorial, oversized */
  .hx-3-top { display: flex; justify-content: space-between; gap: var(--gutter); font-size: 0.875rem; color: var(--muted); }
  .hx-3 .hx-title { margin-top: auto; font-size: clamp(3.25rem, 11.5vw, 15rem); line-height: 0.9; letter-spacing: -0.06em; }
  .hx-3 .hx-title span { display: block; }
  .hx-3-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px var(--gutter); margin-top: clamp(32px, 5vh, 64px); padding-top: 24px; border-top: 1px solid var(--line); }
  .hx-3-row .hx-lede { grid-column: 1 / 3; max-width: 44ch; font-size: clamp(1rem, 1.1vw, 1.25rem); }
  .hx-3-stat b { display: block; font-family: var(--font-display); font-size: clamp(2.5rem, 3.6vw, 4rem); font-weight: 400; line-height: 1; letter-spacing: 0; }
  .hx-3-stat span { display: block; margin-top: 8px; font-size: 0.875rem; color: var(--muted); }
  .hx-3-row .hx-actions { flex-direction: column; align-items: flex-end; justify-content: flex-end; gap: 12px; }

  /* 04 Wordmark ground */
  .hx-4 .hx-glow { left: 50%; bottom: -30%; width: 120vw; height: 60%; translate: -50% 0; background: radial-gradient(closest-side, rgba(110, 50, 255, 0.3), transparent); }
  .hx-4-body { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px var(--gutter); align-items: end; padding-top: clamp(24px, 6vh, 80px); }
  .hx-4 .hx-title { grid-column: 1 / 3; font-size: clamp(2.5rem, 4.6vw, 5.25rem); }
  .hx-4-side { grid-column: 3 / -1; justify-self: end; max-width: 30rem; }
  .hx-4-side .hx-actions { margin-top: 28px; }
  .hx-4-mark { display: flex; justify-content: space-between; margin: auto calc(var(--gutter) * -0.2) calc(clamp(28px, 4vw, 56px) * -1 - 0.14em); padding-top: clamp(32px, 6vh, 80px); font-family: var(--font-display); font-size: clamp(6rem, 29vw, 34rem); line-height: 0.8; white-space: nowrap; user-select: none; }
  .hx-4-mark span { display: inline-block; background: linear-gradient(180deg, rgba(241, 238, 250, 0.95) 0%, rgba(143, 134, 255, 0.35) 70%, rgba(143, 134, 255, 0) 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; translate: 0 30%; opacity: 0; transition: translate 1.1s var(--ease), opacity 0.8s ease; }
  .hx-4-mark span.dot { background-image: linear-gradient(180deg, #971aff 0%, rgba(48, 42, 255, 0.4) 70%, rgba(48, 42, 255, 0) 100%); }
  .hx-4.is-on .hx-4-mark span { translate: 0 0; opacity: 1; }
  {% for i in range(0, 7) %}.hx-4.is-on .hx-4-mark span:nth-child({{ i + 1 }}) { transition-delay: {{ 0.15 + i * 0.06 }}s; }
  {% endfor %}

  /* 05 Three doors */
  .hx-5 .hx-glow { left: 50%; top: 0; width: 80vw; height: 50%; translate: -50% -30%; background: radial-gradient(closest-side, rgba(110, 50, 255, 0.28), transparent); }
  .hx-5-head { display: flex; flex: 1; flex-direction: column; justify-content: center; max-width: 64rem; }
  .hx-5 .hx-title { margin-top: 24px; font-size: clamp(2.75rem, 6.4vw, 7.5rem); }
  .hx-5 .hx-lede { max-width: 50ch; margin-top: 24px; }
  .hx-5-doors { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(40px, 6vh, 80px); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; list-style: none; }
  .hx-5-doors li + li { border-left: 1px solid var(--line); }
  .hx-door { position: relative; display: flex; flex-direction: column; height: 100%; padding: clamp(20px, 2vw, 32px); transition: background-color 0.35s var(--ease); }
  .hx-door::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 2px; background: var(--accent-gradient); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.5s var(--ease); }
  .hx-door:hover { background: rgba(255, 255, 255, 0.035); }
  .hx-door:hover::before { transform: scaleX(1); }
  .hx-door-top { display: flex; justify-content: space-between; align-items: center; }
  .hx-door-top svg { color: var(--muted); transition: color 0.3s ease, transform 0.3s var(--ease); }
  .hx-door:hover .hx-door-top svg { color: var(--ink); transform: translateX(3px) rotate(-45deg); }
  .hx-door h3 { margin-top: clamp(28px, 4vh, 56px); font-size: clamp(1.375rem, 1.8vw, 2rem); font-weight: 500; letter-spacing: -0.035em; }
  .hx-door p { margin-top: 8px; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .hx-door small { margin-top: 18px; font-size: 0.8125rem; color: var(--muted); }
  .hx-door h3 { display: flex; align-items: center; gap: 10px; }

  @media (prefers-reduced-motion: reduce) {
    .hx-in > *, .hx-msg, .hx-4-mark span { opacity: 1 !important; translate: none !important; transition: none !important; }
    .hx-win-input span::after { animation: none; }
  }

  @media (max-width: 960px) {
    .hx-2-body { grid-template-columns: 1fr; padding-top: 40px; }
    .hx-3-row { grid-template-columns: 1fr 1fr; }
    .hx-3-row .hx-lede { grid-column: 1 / -1; }
    .hx-3-row .hx-actions { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: flex-start; }
    .hx-4-body { grid-template-columns: 1fr; }
    .hx-4 .hx-title, .hx-4-side { grid-column: 1; justify-self: start; }
    .hx-5-doors { grid-template-columns: 1fr; }
    .hx-5-doors li + li { border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    .hx-intro { grid-template-columns: 1fr; }
    .hx-intro > div, .hx-cap > p:last-child { grid-column: 1; }
    .hx-cap { grid-template-columns: 1fr; }
    .hx-3-top span:last-child { display: none; }
    .hx-win-body { min-height: 240px; padding: 18px; }
    .hx-win-input { margin: 0 18px 18px; }
  }
</style>

<header class="hx-intro">
  <p class="section-label"><span class="index-num">00</span>Hero</p>
  <div>
    <h1>Five first screens.</h1>
    <p>Five modern, minimalist layouts for the hero, each working, with the real copy and the hero's purple night ground. Each one takes the full first screen; scroll into it to see its entrance.</p>
  </div>
</header>

