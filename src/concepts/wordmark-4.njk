          Sage.is AI-UI v3.2.0
        </a>
        <a class="btn btn-ghost" href="https://sage.education" target="_blank" rel="noopener">Sage Education</a>
        <a class="btn btn-ghost" href="https://sage.is/programs#packages" target="_blank" rel="noopener">Technical Capital</a>
      </div>
    </div>
  </div>
</section>
{% endfor %}

<script>
(function () {
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // SAGE.IS as a field of dots. The word is drawn four times finer than the grid, and each cell's
  // share of ink sets its dot: small and grey outside, larger and in the purples inside. On the
  // dark ground the purples are lifted and the grey is light, so both read as clearly
  var THEMES = {
    light: { from: [48, 42, 255], to: [151, 26, 255], grey: [22, 19, 31], out: 0.2, light: [205, 192, 255], lift: 0.55 },
    dark: { from: [100, 92, 255], to: [180, 98, 255], grey: [241, 238, 250], out: 0.17, light: [244, 240, 255], lift: 0.7 }
  };

  function build(field) {
    var canvas = field.querySelector('canvas'), W = field.clientWidth, t = THEMES[field.dataset.wfDots] || THEMES.light;
    if (!W) return;
    var pitch = Math.max(6, W / 136), cols = Math.floor(W / pitch), k = 4;
    var m = document.createElement('canvas').getContext('2d');
    m.font = '100px Anton';
    var mt = m.measureText('SAGE.IS'), left = mt.actualBoundingBoxLeft, asc = mt.actualBoundingBoxAscent;
    var s = cols * 0.84 / (left + mt.actualBoundingBoxRight), wordH = (asc + mt.actualBoundingBoxDescent) * s;
    var rows = Math.round(wordH + 8), H = rows * pitch;

    var mask = document.createElement('canvas'); mask.width = cols * k; mask.height = rows * k;
    var mc = mask.getContext('2d');
    mc.font = (100 * s * k) + 'px Anton'; mc.fillStyle = '#000';
    mc.fillText('SAGE.IS', (cols * 0.08 + left * s) * k, ((rows - wordH) / 2 + asc * s) * k);
    var ink = mc.getImageData(0, 0, mask.width, mask.height).data;

    var dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); canvas.style.height = H + 'px';
    var ox = (W - cols * pitch) / 2, dots = [];
    for (var r = 0; r < rows; r++) {
      for (var col = 0; col < cols; col++) {
        var cov = 0;
        for (var y = 0; y < k; y++) for (var x = 0; x < k; x++) cov += ink[((r * k + y) * mask.width + col * k + x) * 4 + 3];
        cov /= k * k * 255;
        // Soft edges: the field thins out towards its sides, top and bottom
        var edge = Math.min(1, Math.min(col, cols - 1 - col) / 7) * Math.min(1, Math.min(r, rows - 1 - r) / 3);
        var f = col / (cols - 1);
        dots.push({
          x: ox + (col + 0.5) * pitch, y: (r + 0.5) * pitch, cov: cov,
          // When it switches on in the entrance: mostly left to right, a little scattered
          delay: 0.6 * f + 0.1 * r / rows + 0.3 * rand(col, r),
          tint: t.from.map(function (v, i) { return v + (t.to[i] - v) * f; }),
          a: cov > 0.02 ? 0.35 + 0.65 * cov : t.out * edge
        });
      }
    }
    field.wf = field.wf || { start: 0 };
    Object.assign(field.wf, { canvas: canvas, ctx: canvas.getContext('2d'), dpr: dpr, W: W, H: H, pitch: pitch, dots: dots, t: t });
    paint(field.wf, field.wf.start && !still ? performance.now() - field.wf.start : (still ? Infinity : 0));
    field.classList.add('is-drawn');
  }

  // A steady random per dot, so the entrance scatters the same way on every load
  function rand(x, y) { var n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); }
  function outBack(x) { var c = 1.9; return 1 + (c + 1) * Math.pow(x - 1, 3) + c * Math.pow(x - 1, 2); }

  // The entrance, el milliseconds in (Infinity: finished). The grey field fades in from the left;
  // then each dot of the word switches on in its turn, springing from a grey point to its full
  // size and purple, with a brief flash of the theme's light as it lands
  var FIELD = 700, SPAN = 1300, DOT = 520;
  function paint(w, el) {
    var c = w.ctx, t = w.t, G = t.grey, L = t.light;
    c.setTransform(w.dpr, 0, 0, w.dpr, 0, 0);
    c.clearRect(0, 0, w.W, w.H);
    for (var i = 0; i < w.dots.length; i++) {
      var d = w.dots[i], inside = d.cov > 0.02, out = w.pitch * 0.13;
      var base = Math.min(1, Math.max(0, (el - d.x / w.W * FIELD * 0.6) / (FIELD * 0.4)));
      var a = (inside ? t.out : d.a) * base, rad = out, rgb = G;
      if (inside) {
        var k = Math.min(1, Math.max(0, (el - FIELD * 0.5 - d.delay * SPAN) / DOT));
        if (k > 0) {
          var flash = Math.sin(Math.PI * Math.min(1, k * 1.4)) * t.lift;
          rad = out + (w.pitch * (0.13 + 0.22 * d.cov) - out) * outBack(k);
          rgb = d.tint.map(function (v, j) { return Math.round(G[j] + (v - G[j]) * Math.min(1, k * 2) + (L[j] - v) * flash); });
          a = a + (d.a - a) * Math.min(1, k * 2);
        }
      }
      c.fillStyle = 'rgba(' + rgb.join(',') + ',' + a.toFixed(3) + ')';
      c.beginPath();
      c.arc(d.x, d.y, Math.max(0, rad), 0, Math.PI * 2);
      c.fill();
    }
  }

  // Plays the entrance once, the first time the hero comes into view, then rests
  var TOTAL = FIELD * 0.5 + SPAN + DOT + 60;
  function play(field) {
    var w = field.wf;
    if (!w || w.start) return;
    w.start = performance.now();
    (function frame() {
      var el = performance.now() - w.start;
      paint(field.wf, el);
      if (el < TOTAL) requestAnimationFrame(frame);
      else paint(field.wf, Infinity);
    })();
  }

  var fields = document.querySelectorAll('[data-wf-dots]');
  var seen = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting || still) return;
      e.target.wfSeen = true; play(e.target);
    });
  }, { threshold: 0.4 });
  function all() {
    fields.forEach(function (f) { build(f); if (f.wfSeen) play(f); });
    fields.forEach(function (f) { seen.observe(f); });
  }
  var timer;
  addEventListener('resize', function () { clearTimeout(timer); timer = setTimeout(all, 150); });
  if (document.fonts) document.fonts.load('100px Anton').then(all, all); else all();
})();
</script>
