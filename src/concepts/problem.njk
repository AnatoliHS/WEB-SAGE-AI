<script>
(function () {
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var FROM = [48, 42, 255], TO = [151, 26, 255], INK = [22, 19, 31];
  function rand(x, y) { var n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); }
  function clamp01(v) { return Math.min(1, Math.max(0, v)); }
  function smooth(a, b, x) { var k = clamp01((x - a) / (b - a)); return k * k * (3 - 2 * k); }
  function mix(a, b, k) { return a.map(function (v, i) { return Math.round(v + (b[i] - v) * k); }); }
  function rgba(c, a) { return 'rgba(' + c.join(',') + ',' + a.toFixed(3) + ')'; }
  function dot(c, x, y, r, col) { if (r <= 0.05) return; c.fillStyle = col; c.beginPath(); c.arc(x, y, r, 0, 6.2832); c.fill(); }

  var bands = [].map.call(document.querySelectorAll('[data-pb]'), function (el) {
    return { el: el, kind: el.dataset.pb, canvas: el.querySelector('canvas') };
  });

  function size(b) {
    var dpr = Math.min(devicePixelRatio || 1, 2);
    b.W = b.el.clientWidth; b.H = b.el.clientHeight; b.dpr = dpr;
    b.canvas.width = Math.round(b.W * dpr); b.canvas.height = Math.round(b.H * dpr);
    b.ctx = b.canvas.getContext('2d');
    if (b.kind === 'static') {
      // The tick, as a mask over the solution's side
      var m = document.createElement('canvas'); m.width = b.W; m.height = b.H;
      var mc = m.getContext('2d'), s = b.H * 0.78;
      mc.lineWidth = s * 0.17; mc.lineCap = 'round'; mc.lineJoin = 'round';
      var x0 = b.W * 0.76 - s * 0.45, y0 = b.H / 2;
      mc.beginPath(); mc.moveTo(x0, y0); mc.lineTo(x0 + s * 0.3, y0 + s * 0.3); mc.lineTo(x0 + s * 0.9, y0 - s * 0.36); mc.stroke();
      b.tick = mc.getImageData(0, 0, b.W, b.H).data;
    }
    if (b.kind === 'funnel') {
      b.parts = [];
      for (var i = 0; i < 220; i++) b.parts.push({ y: rand(i, 1) * b.H, sp: 0.06 + rand(i, 2) * 0.08, ph: rand(i, 3), w: rand(i, 4) * 6.28, a: 0.4 + rand(i, 5) * 0.6 });
    }
  }

  // u: 0 as the band comes up the screen, 1 by the time it's most of the way up (as today's)
  function draw(b, t) {
    var r = b.el.getBoundingClientRect(), vh = innerHeight;
    if (r.bottom < 0 || r.top > vh) return;
    var u = still ? 0.6 : clamp01((vh - r.top) / (vh * 0.9));
    var c = b.ctx, W = b.W, H = b.H, P = 10;
    c.setTransform(b.dpr, 0, 0, b.dpr, 0, 0);
    c.clearRect(0, 0, W, H);

    if (b.kind === 'signal') {
      var edge = W * (0.62 - 0.32 * u), calm = 1 - 0.6 * u;
      for (var gy = P / 2; gy < H; gy += P) for (var gx = P / 2; gx < W; gx += P) {
        var k = (1 - smooth(edge - W * 0.22, edge + W * 0.08, gx)) * calm;
        var i = gx * 7 + gy;
        var dx = (rand(i, 1) - 0.5) * 90 + Math.sin(t * (0.6 + rand(i, 2)) + rand(i, 3) * 6.28) * 14;
        var dy = (rand(i, 4) - 0.5) * H * 0.9 + Math.cos(t * (0.5 + rand(i, 5)) + rand(i, 6) * 6.28) * 10;
        var x = gx + dx * k, y = gy + dy * k;
        if (y < 0 || y > H) continue;
        var order = 1 - k / Math.max(0.001, calm) * 1;
        var col = mix(INK, mix(FROM, TO, gx / W), clamp01(order));
        var rad = k > 0.05 ? 0.8 + rand(i, 7) * 1.6 : 1.9;
        var a = 0.14 + 0.66 * clamp01(order) + (k > 0.05 ? rand(i, 8) * 0.2 : 0);
        // Keep the ordered grid sparse, every other row, so it reads as rows
        if (k < 0.05 && Math.round(gy / P) % 2) continue;
        dot(c, x, y, rad, rgba(col, a));
      }
    } else if (b.kind === 'knot') {
      var N = 16, gap = H / (N + 3);
      for (var li = 0; li < N; li++) {
        var f1 = 0.006 + rand(li, 1) * 0.012, f2 = 0.015 + rand(li, 2) * 0.02, p1 = rand(li, 3) * 6.28, p2 = rand(li, 4) * 6.28, s = 0.4 + rand(li, 5) * 0.8;
        var base = H / 2 + (li - (N - 1) / 2) * gap;
        for (var x2 = 0; x2 <= W; x2 += 9) {
          var k2 = Math.pow(1 - clamp01(x2 / (W * (0.42 + 0.3 * u))), 1.6) * (1 - 0.55 * u);
          var y2 = base + H * 0.42 * k2 * (Math.sin(x2 * f1 + p1 + t * s) * 0.7 + Math.sin(x2 * f2 + p2 - t * s * 1.4) * 0.5) - (base - H / 2) * k2 * 0.9;
          var o2 = 1 - Math.min(1, k2 * 2.2);
          dot(c, x2, y2, 1.1 + 0.7 * o2, rgba(mix(INK, mix(FROM, TO, x2 / W), o2), 0.3 + 0.6 * o2));
        }
      }
    } else if (b.kind === 'static') {
      var settle = W * (1 - 0.62 * u), frameN = Math.floor(t * 12);
      for (var sy = P / 2; sy < H; sy += P) for (var sx = P / 2; sx < W; sx += P) {
        var j = sx * 13 + sy, kk = smooth(settle - 120, settle + 40, sx + rand(j, 9) * 80);
        var inTick = b.tick[((Math.round(sy) * W) + Math.round(sx)) * 4 + 3] > 120;
        if (kk > 0.5) {
          if (inTick) dot(c, sx, sy, 3.2, rgba(mix(FROM, TO, sx / W), 0.95));
          else dot(c, sx, sy, 1.2, rgba(INK, 0.12));
        } else {
          var on = rand(j, frameN) > 0.55;
          dot(c, sx, sy, on ? 1.2 + rand(j, frameN + 1) * 1.6 : 1, rgba(INK, on ? 0.18 + rand(j, frameN + 2) * 0.35 : 0.06));
        }
      }
    } else if (b.kind === 'funnel') {
      var nx = W * 0.74, ny = H / 2, tight = 0.4 + 0.6 * u;
      b.parts.forEach(function (p, i) {
        var q = (p.ph + t * p.sp) % 1, e = q * q * (3 - 2 * q);
        var wob = Math.sin(t * 1.3 + p.w + q * 9) * (1 - e) * H * 0.18 * (1.2 - tight);
        var x = q * nx, y = p.y + (ny - p.y) * Math.pow(e, 0.7 + 0.8 * (1 - tight)) + wob;
        dot(c, x, y, 1 + 1.4 * (1 - e) * p.a, rgba(mix(INK, FROM, e), (0.2 + 0.7 * e) * p.a));
      });
      for (var ox = nx + 14; ox < W; ox += 10) dot(c, ox, ny, 2, rgba(mix(FROM, TO, ox / W), 0.9));
      var pulse = 0.5 + 0.5 * Math.sin(t * 3);
      c.shadowColor = 'rgba(151,26,255,.8)'; c.shadowBlur = 18 + 10 * pulse;
      dot(c, nx, ny, 6 + pulse * 1.5, '#971aff'); c.shadowBlur = 0;
    } else if (b.kind === 'eq') {
      var B = 14, rows = Math.floor(H / 9), steady = W * (0.62 - 0.32 * u);
      for (var bx = B / 2; bx < W; bx += B) {
        var kq = smooth(steady - W * 0.15, steady + W * 0.05, bx);
        var ramp = 0.15 + 0.8 * clamp01((bx - W * 0.3) / (W * 0.7));
        var jump = rand(bx, Math.floor(t * 7 + rand(bx, 1) * 3));
        var hgt = Math.round(rows * (jump * (1 - kq) + ramp * kq));
        for (var rr = 0; rr < rows; rr++) {
          var yy = H - 5 - rr * 9, lit = rr < hgt;
          dot(c, bx, yy, lit ? 2.2 : 1, lit ? rgba(mix(INK, mix(FROM, TO, rr / rows), kq), 0.25 + 0.65 * kq + (1 - kq) * 0.1) : rgba(INK, 0.07));
        }
      }
    }
  }

  function frame() {
    var t = still ? 0 : performance.now() / 1000;
    bands.forEach(function (b) { draw(b, t); });
    if (!still) requestAnimationFrame(frame);
  }
  function all() { bands.forEach(size); if (still) frame(); }
  addEventListener('resize', function () { clearTimeout(all.t); all.t = setTimeout(all, 150); });
  if (still) addEventListener('scroll', frame, { passive: true });
  all();
  if (!still) requestAnimationFrame(frame);
})();
</script>
