        </li>
        <li class="p3-msg">
          <span class="p3-avatar is-team" aria-hidden="true">?</span>
          <p class="p3-text">{{ cP2 | safe }}</p>
        </li>
        <li class="p3-msg is-quote" data-typed>
          <span class="p3-avatar is-izzy" aria-hidden="true">IP</span>
          <p class="p3-who"><strong>Izzy Plante</strong>Co-founder &amp; CEO</p>
          <span class="p3-typing" aria-hidden="true"><i></i><i></i><i></i></span>
          <p class="p3-text">{{ quote | safe }}</p>
        </li>
        <li class="p3-subject is-solution"><b>{{ sLabel }}</b>{{ sTitle }}</li>
        <li class="p3-msg" data-typed>
          <span class="p3-avatar is-izzy" aria-hidden="true">IP</span>
          <p class="p3-who"><strong>Izzy Plante</strong>Co-founder &amp; CEO</p>
          <span class="p3-typing" aria-hidden="true"><i></i><i></i><i></i></span>
          <p class="p3-text">{{ sP1 | safe }}</p>
        </li>
        <li class="p3-msg" data-typed>
          <span class="p3-avatar is-izzy" aria-hidden="true">IP</span>
          <p class="p3-who"><strong>Izzy Plante</strong>Co-founder &amp; CEO</p>
          <span class="p3-typing" aria-hidden="true"><i></i><i></i><i></i></span>
          <p class="p3-text">{{ sP2 | safe }}</p>
        </li>
        <li class="p3-mail">{{ mail() }}</li>
      </ol>
      <div class="p3-side">{{ shot() }}</div>
    </div>
  </div>
</section>

{# ===================== 4. ANNOTATED STAGE ===================== #}
<section class="gx-option" id="stage">
  <div class="gx-about"><h2><b>04</b>{{ layouts[3].name }}</h2><p>{{ layouts[3].note }}</p></div>
  <div class="gx-demo p4">
    <div class="ambient-glow ambient-glow--center" aria-hidden="true"></div>
    {{ head() }}
    <div class="p4-grid">
      <article class="p4-note is-top px-copy">
        <p class="contrast-label">{{ cLabel }}</p>
        <h3 class="contrast-title">{{ cTitle }}</h3>
        <p>{{ cP1 | safe }}</p>
        <p>{{ cP2 | safe }}</p>
      </article>
      <div class="p4-scene" data-p4>
        <div class="p4-tilt">
          {{ shot() }}
          <div class="p4-quote"><p class="pull-quote">{{ quote | safe }}</p></div>
        </div>
      </div>
      <article class="p4-note is-bottom px-copy">
        <p class="contrast-label">{{ sLabel }}</p>
        <h3 class="contrast-title">{{ sTitle }}</h3>
        <p>{{ sP1 | safe }}</p>
        <p>{{ sP2 | safe }}</p>
        {{ signature() }}
      </article>
      <p class="showcase-caption p4-caption" style="grid-row: 3; grid-column: 1 / span 2; align-self: start; margin-top: 24px;">Sage.is what will make your projects succeed.</p>
    </div>
  </div>
</section>

{# ===================== 5. STRIKE-THROUGH ===================== #}
<section class="gx-option" id="strike">
  <div class="gx-about"><h2><b>05</b>{{ layouts[4].name }}</h2><p>{{ layouts[4].note }}</p></div>
  <div class="gx-demo p5" data-p5>
    <div class="ambient-glow ambient-glow--right" aria-hidden="true"></div>
    {{ head() }}
    <div class="p5-small">
      <div class="px-copy">
        <p class="contrast-label">{{ cLabel }}</p>
        <h3 class="contrast-title">{{ cTitle }}</h3>
        <p>{{ cP1 | safe }}</p>
      </div>
    </div>
    {# The second paragraph of the challenge, the same words, with the four to strike wrapped #}
    <p class="p5-big"><strong>Unfortunately, most AI tools work great for individuals,</strong> but <strong>terribly for teams, especially ones that want to do new things</strong> either <span class="p5-x" style="--d: 0.3s">overwhelming</span>, <span class="p5-x" style="--d: 0.75s">inadequate</span>, <span class="p5-x" style="--d: 1.2s">bewildering</span>, or <span class="p5-x" style="--d: 1.65s">chaotic</span>. Right?</p>
    <p class="p5-answer">{{ quote | safe }}</p>
    <div class="p5-close">
      <div class="px-copy">
        <p class="contrast-label">{{ sLabel }}</p>
        <h3 class="contrast-title">{{ sTitle }}</h3>
        <p>{{ sP1 | safe }}</p>
        <p>{{ sP2 | safe }}</p>
        {{ signature() }}
      </div>
      {{ shot() }}
    </div>
  </div>
</section>

<script>
(() => {
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp01 = (v) => Math.min(Math.max(v, 0), 1);
  const ease = (k) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);
  const onView = (el, fn, threshold = 0.35) => {
    if (!el) return;
    if (!('IntersectionObserver' in window)) return fn();
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); fn(); } }, { threshold });
    io.observe(el);
  };

  // 1. Before / After: the solution sweeps in from the right once, then the handle follows a drag
  const cmp = document.querySelector('[data-p1]');
  if (cmp) {
    const set = (pct) => cmp.style.setProperty('--split', `${pct}%`);
    let dragging = false, swept = false;
    onView(cmp, () => {
      if (reduced) { set(50); return; }
      const t0 = performance.now();
      const run = (now) => {
        if (dragging) return;
        const k = ease(clamp01((now - t0) / 1800));
        set(100 - k * 50);
        if (k < 1) requestAnimationFrame(run); else swept = true;
      };
      requestAnimationFrame(run);
    });
    const move = (e) => {
      const r = cmp.getBoundingClientRect();
      set(clamp01((e.clientX - r.left) / r.width) * 100);
    };
    cmp.addEventListener('pointerdown', (e) => { dragging = true; cmp.setPointerCapture(e.pointerId); move(e); });
    cmp.addEventListener('pointermove', (e) => { if (dragging) move(e); });
    cmp.addEventListener('pointerup', () => { dragging = false; });
  }

  // 2. Untangle: lines knotted over the challenge, combed straight over the solution; scrolling
  //    through the band unties more of the knot
  const band = document.querySelector('[data-p2]');
  if (band) {
    const canvas = band.querySelector('canvas');
    const ctx = canvas.getContext('2d');
    const N = 16;
    const lines = Array.from({ length: N }, (_, i) => ({
      f1: 0.006 + Math.random() * 0.012, f2: 0.015 + Math.random() * 0.02,
      p1: Math.random() * 6.28, p2: Math.random() * 6.28, s: 0.4 + Math.random() * 0.8, i,
    }));
    let W = 0, H = 0, visible = false;
    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = band.clientWidth; H = band.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    size();
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(band);
    const draw = (now) => {
      requestAnimationFrame(draw);
      if (!visible) return;
      const r = band.getBoundingClientRect();
      // 0 as the band comes up the screen, 1 by the time it's two thirds of the way up
      const untie = reduced ? 0.6 : clamp01((innerHeight - r.top) / (innerHeight * 0.9));
      const t = reduced ? 0 : now / 1000;
      ctx.clearRect(0, 0, W, H);
      const grad = ctx.createLinearGradient(0, 0, W, 0);
      grad.addColorStop(0, 'rgba(238, 233, 226, 0.28)');
      grad.addColorStop(0.5, 'rgba(238, 233, 226, 0.35)');
      grad.addColorStop(0.78, 'rgba(143, 134, 255, 0.9)');
      grad.addColorStop(1, 'rgba(151, 26, 255, 0.9)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.2;
      const gap = H / (N + 3);
      lines.forEach((l) => {
        const base = H / 2 + (l.i - (N - 1) / 2) * gap;
        ctx.beginPath();
        for (let x = 0; x <= W; x += 6) {
          // How knotted at this point: all of it on the left, none past the middle; less as it unties
          const k = Math.pow(1 - clamp01(x / (W * (0.42 + 0.3 * untie))), 1.6) * (1 - 0.55 * untie);
          const amp = H * 0.42 * k;
          const y = base + amp * (Math.sin(x * l.f1 + l.p1 + t * l.s) * 0.7 + Math.sin(x * l.f2 + l.p2 - t * l.s * 1.4) * 0.5) - (base - H / 2) * k * 0.9;
          x ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
        }
        ctx.stroke();
      });
    };
    requestAnimationFrame(draw);
  }

  // 3. Thread: messages arrive in turn; Izzy's show a typing indicator first
  const thread = document.querySelector('[data-p3]');
  if (thread) {
    const msgs = Array.from(thread.querySelectorAll('.p3-msg'));
    onView(thread, () => {
      let at = 0;
      msgs.forEach((m) => {
        const typed = m.hasAttribute('data-typed') && !reduced;
        setTimeout(() => {
          m.classList.add('is-in');
          if (typed) {
            m.classList.add('is-typing');
            setTimeout(() => m.classList.remove('is-typing'), 900);
          }
        }, at);
        at += reduced ? 0 : typed ? 1500 : 650;
      });
    }, 0.2);
  }

  // 4. Annotated stage: the shot leans back and stands up as it comes up the screen
  const scene = document.querySelector('[data-p4]');
  if (scene) {
    const tilt = scene.querySelector('.p4-tilt');
    const update = () => {
      const r = scene.getBoundingClientRect();
      const k = reduced ? 1 : ease(clamp01((innerHeight - r.top) / (innerHeight * 0.85)));
      tilt.style.setProperty('--tilt', `${22 * (1 - k)}deg`);
      tilt.style.setProperty('--zoom', `${0.92 + 0.08 * k}`);
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }

  // 5. Strike-through: strike the four words in turn once the sentence is on screen
  onView(document.querySelector('[data-p5] .p5-big'), () => document.querySelector('[data-p5]').classList.add('is-on'), 0.6);
})();
</script>
