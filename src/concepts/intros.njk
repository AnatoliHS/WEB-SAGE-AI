---
layout: policy.njk
title: "Intro options: Sage"
description: Six loading screens, each handing over into the real hero, side by side.
noindex: true
permalink: /concepts/intros/
---
<style>
  .ix-head { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px var(--gutter); padding-top: 20px; border-top: 1px solid var(--line); }
  .ix-head > div { grid-column: 2 / -1; }
  .ix-head h1 { font-size: clamp(2.5rem, 5vw, 5.5rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; }
  .ix-head p { margin-top: 20px; max-width: 60ch; font-size: clamp(1.0625rem, 1.2vw, 1.375rem); line-height: 1.55; color: var(--ink-2); }
  .ix-head p + p { margin-top: 12px; font-size: 0.9375rem; color: var(--muted); }

  .ix-bar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: clamp(40px, 5vw, 72px); padding: 14px 0; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .ix-jump { display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; font-size: 0.875rem; }
  .ix-jump a { color: var(--ink-2); transition: color 0.2s; }
  .ix-jump a:hover { color: var(--ink); }
  .ix-jump b { margin-right: 6px; font-weight: 500; color: var(--accent-soft); }
  .ix-device { display: inline-flex; padding: 3px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); }
  .ix-device button { height: 32px; padding: 0 14px; border-radius: 999px; font-size: 0.8125rem; color: var(--ink-2); transition: background 0.25s, color 0.25s; }
  .ix-device button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }

  .ix-option { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.3fr); gap: 32px clamp(32px, 4vw, 72px); padding: clamp(48px, 6vw, 96px) 0; border-bottom: 1px solid var(--line); scroll-margin-top: 64px; }
  .ix-label { display: flex; gap: 14px; align-items: baseline; font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
  .ix-label b { font-weight: 500; color: var(--accent-soft); letter-spacing: 0; }
  .ix-option h2 { margin-top: 16px; font-size: clamp(2rem, 3.2vw, 3.5rem); font-weight: 500; line-height: 1; letter-spacing: -0.045em; }
  .ix-option h2 small { margin-left: 10px; font-size: 0.875rem; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .ix-summary { margin-top: 18px; font-size: clamp(1rem, 1.05vw, 1.1875rem); line-height: 1.6; color: var(--ink-2); }
  .ix-changes { margin-top: 22px; list-style: none; font-size: 0.9375rem; color: var(--ink-2); }
  .ix-changes li { position: relative; padding: 9px 0 9px 22px; border-top: 1px solid var(--line); }
  .ix-changes li::before { content: ""; position: absolute; left: 2px; top: 1.05em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-soft); }
  .ix-mood { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 18px; list-style: none; font-size: 0.8125rem; color: var(--muted); }
  .ix-mood li::before { content: "#"; color: var(--accent-soft); }

  .ix-stage-wrap { min-width: 0; }
  .ix-stage { position: relative; overflow: hidden; aspect-ratio: 1440 / 900; border-radius: 14px; background: #000; box-shadow: 0 0 0 1px var(--line), 0 40px 100px -50px rgba(0, 0, 0, 0.9); }
  .ix-stage iframe { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; border: 0; transform-origin: 0 0; pointer-events: none; }
  .ix-stage-empty { position: absolute; inset: 0; display: grid; place-items: center; font-size: 0.875rem; color: var(--muted); }
  [data-device="phone"] .ix-stage { aspect-ratio: 390 / 844; width: min(100%, 340px); border-radius: 28px; }
  [data-device="phone"] .ix-stage iframe { width: 390px; height: 844px; }
  .ix-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 16px; }
  .ix-controls a { font-size: 0.875rem; color: var(--ink-2); transition: color 0.2s; }
  .ix-controls a:hover { color: var(--accent-soft); }

  @media (max-width: 960px) {
    .ix-head { grid-template-columns: 1fr; }
    .ix-head > div { grid-column: 1; }
    .ix-option { grid-template-columns: 1fr; }
    .ix-stage-wrap { order: -1; }
  }
</style>

<header class="ix-head">
  <p class="section-label"><span class="index-num">00</span>Intro options</p>
  <div>
    <h1>Six ways in.</h1>
    <p>Each loading screen below runs on the real hero and hands over into it: every one ends on the hero rule, with the real SAGE.IS wordmark appearing in place. Option 1 is the current star intro, rebuilt; 2 to 6 are new directions.</p>
    <p>Each frame plays when it scrolls into view. Use Replay to watch it again, or open it full screen to see it at real size (a click or a key skips it, as it will on the site). The homepage uses option 6, Prompt.</p>
  </div>
</header>

<div class="ix-bar">
  <ul class="ix-jump">
    {% for o in intros %}<li><a href="#{{ o.slug }}"><b>0{{ loop.index }}</b>{{ o.name }}</a></li>{% endfor %}
  </ul>
  <div class="ix-device" role="group" aria-label="Preview size">
    <button type="button" data-device-btn="desktop" aria-pressed="true">Desktop</button>
    <button type="button" data-device-btn="phone" aria-pressed="false">Phone</button>
  </div>
</div>

<div class="ix-list" data-device="desktop">
  {% for o in intros %}
  <section class="ix-option" id="{{ o.slug }}">
    <div>
      <p class="ix-label"><b>0{{ loop.index }}</b>{{ o.tag }}</p>
      <h2>{{ o.name }}<small>{{ o.length }}</small></h2>
      <p class="ix-summary">{{ o.summary }}</p>
      <ul class="ix-changes">
        {% for c in o.changes %}<li>{{ c }}</li>{% endfor %}
      </ul>
      <ul class="ix-mood">
        {% for m in o.mood %}<li>{{ m }}</li>{% endfor %}
      </ul>
    </div>
    <div class="ix-stage-wrap">
      <div class="ix-stage" data-stage>
        <span class="ix-stage-empty">Loading…</span>
        <iframe data-src="/concepts/intros/{{ o.slug }}/" title="{{ o.name }} intro preview" loading="lazy" tabindex="-1"></iframe>
      </div>
      <div class="ix-controls">
        <button type="button" class="btn btn-ghost btn-sm" data-replay>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 3 3 9 9 9"/></svg>
          Replay
        </button>
        <a href="/concepts/intros/{{ o.slug }}/" target="_blank" rel="noopener">Open full screen ↗</a>
      </div>
    </div>
  </section>
  {% endfor %}
</div>

<script>
(() => {
  const list = document.querySelector('.ix-list');
  const stages = Array.from(document.querySelectorAll('[data-stage]'));
  const size = () => list.dataset.device === 'phone' ? [390, 844] : [1440, 900];

  // Scale each 1440×900 (or phone-sized) page down to fit its frame
  const fit = (stage) => {
    const frame = stage.querySelector('iframe');
    frame.style.transform = `scale(${stage.clientWidth / size()[0]})`;
  };
  const ro = new ResizeObserver((entries) => entries.forEach((e) => fit(e.target)));
  stages.forEach((s) => ro.observe(s));

  const play = (stage) => {
    const frame = stage.querySelector('iframe');
    frame.src = frame.dataset.src + '?t=' + Date.now();
    fit(stage);
  };

  // Play each one as it comes into view (and only once, until replayed)
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (!e.isIntersecting) return;
    io.unobserve(e.target);
    play(e.target);
  }), { threshold: 0.45 });
  stages.forEach((s) => io.observe(s));

  document.querySelectorAll('[data-replay]').forEach((btn) => {
    btn.addEventListener('click', () => play(btn.closest('.ix-stage-wrap').querySelector('[data-stage]')));
  });

  document.querySelectorAll('[data-device-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      list.dataset.device = btn.dataset.deviceBtn;
      document.querySelectorAll('[data-device-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      // Replay the ones already started, at the new size
      stages.forEach((s) => { if (s.querySelector('iframe').src) play(s); });
    });
  });
})();
</script>
