    c.fillStyle = '#0a0812'; c.fillRect(o.px - o.paperW / 2 - 6, o.slot - 4, o.paperW + 12, 6);
    var on = printing >= 0 && Math.floor(now / 180) % 2;
    dot(c, o.px + bw / 2 - 22, o.slot + 30, 4, on ? '#b462ff' : 'rgba(180,98,255,0.35)');
    for (var g = 0; g < 8; g++) dot(c, o.px - bw / 2 + 24 + g * 9, o.slot + 30, 1.6, 'rgba(255,255,255,0.18)');
    var answered = 0; for (var s2 = 1; s2 <= 3; s2++) if (prog[s2] > 0.7) answered++;
    return answered;
  });

  // ---------------------------------------------------------------- one loop for them all
  var running = false;
  function frame() {
    var now = performance.now(), more = false;
    opts.forEach(function (o) { if (o.ctx && o.draw(now)) more = true; });
    if (more) requestAnimationFrame(frame); else running = false;
  }
  function wake() { if (!running) { running = true; requestAnimationFrame(frame); } }
  function start() {
    W_ = { YES: sample('YES', 26), YES26: sample('YES', 24), YESX: sample('YES!', 26), Q: sample('?', 30) };
    opts.forEach(function (o) { o.size(); });
    wake();
  }
  addEventListener('scroll', wake, { passive: true });
  addEventListener('resize', function () { clearTimeout(start.t); start.t = setTimeout(start, 150); });
  if (document.fonts) document.fonts.load('100px Anton').then(start, start); else start();
})();
</script>
