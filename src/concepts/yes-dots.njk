  }
  // Breaks text into lines of at most n characters
  function wrap(text, n) {
    var out = [], line = '';
    text.split(' ').forEach(function (w) { if ((line + ' ' + w).trim().length > n) { out.push(line.trim()); line = w; } else line += ' ' + w; });
    if (line.trim()) out.push(line.trim());
