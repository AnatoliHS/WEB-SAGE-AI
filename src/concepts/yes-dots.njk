  }

  var QS = ['CAN OUR VISION BE INCUBATED AND GROW WITH AI/ML EXPERTS?', 'CAN WE ACCESS HANDS-ON TECHNICAL SUPPORT?', 'CAN OUR TEAM ACCELERATE FROM IDEA TO IMPACT QUICKLY?'];
  var TAGS = ['EXPERT INCUBATION', 'DIRECT ASSISTANCE', 'SPEED TO MARKET'];
  var STATUS = ['FULLY SUPPORTED & TAILORED', '99.99% UPTIME & FOUNDER ACCESS', 'PRODUCTION READY IN DAYS'];
  // The held screen's parts as the scroll goes: the intro, the three questions, the answer
  var AT = [0, 0.12, 0.33, 0.54, 0.75, 1];
  function stepOf(p) { for (var i = AT.length - 2; i >= 0; i--) if (p >= AT[i]) return i; return 0; }
  var W_ = {};

  var opts = [];

  // ---------------------------------------------------------------- 01 the current one, in dots
  (function () {
    var pin = document.querySelector('[data-yp="current"]');
    if (!pin) return;
    var track = pin.querySelector('.yes-track'), steps = [].slice.call(pin.querySelectorAll('.yes-step')), fin = pin.querySelector('.yes-final');
    var bar = pin.querySelector('.yes-progress i'), count = pin.querySelector('[data-yes-count]');
    var canvas = document.createElement('canvas'); canvas.className = 'yp-track-canvas'; canvas.setAttribute('aria-hidden', 'true');
    track.prepend(canvas);
