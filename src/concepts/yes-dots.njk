    o.size = function () {
      var vw = innerWidth, vh = innerHeight;
      var nodes = steps.map(function (st) { return st.offsetLeft; }), ny = steps[0].querySelector('.yes-node').offsetTop;
      travel = Math.max(0, fin.offsetLeft + fin.offsetWidth / 2 - vw / 2); dwell = vh * 0.35;
      pin.style.height = (vh + travel + dwell) + 'px';
      var w = track.scrollWidth, h = track.offsetHeight + TOP + 60, dpr = Math.min(devicePixelRatio || 1, 2);
