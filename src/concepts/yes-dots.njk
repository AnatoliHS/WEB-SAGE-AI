<script>
(function () {
  var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var FROM = [48, 42, 255], TO = [151, 26, 255], INK = [22, 19, 31], LIGHT = [205, 192, 255], LAV = [181, 143, 224];
  function rand(x, y) { var n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); }
  function clamp01(v) { return Math.min(1, Math.max(0, v)); }
  function seg(p, a, b) { return clamp01((p - a) / (b - a)); }
  function outBack(x) { return 1 + 2.9 * Math.pow(x - 1, 3) + 1.9 * Math.pow(x - 1, 2); }
  function inOut(k) { return k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2; }
  function mix(a, b, k) { return a.map(function (v, i) { return Math.round(v + (b[i] - v) * k); }); }
  function rgba(c, a) { return 'rgba(' + c.join(',') + ',' + a.toFixed(3) + ')'; }
  function dot(c, x, y, r, col) { if (r <= 0.05) return; c.fillStyle = col; c.beginPath(); c.arc(x, y, r, 0, 6.2832); c.fill(); }

  // Text sampled from Anton onto a grid rowsTall dots high, letter by letter as the wordmark is
  // set: each dot with its coverage, its letter (ch), and when it switches on (d, 0 to 1)
  function sample(text, rowsTall) {
    var m = document.createElement('canvas').getContext('2d'); m.font = '100px Anton';
    var xs = [], ms = [], pen = 0;
    for (var i = 0; i < text.length; i++) { var mt = m.measureText(text[i]); xs.push(pen); ms.push(mt); pen += mt.width + 3; }
    var last = text.length - 1, left = xs[0] - ms[0].actualBoundingBoxLeft, right = xs[last] + ms[last].actualBoundingBoxRight;
    var asc = Math.max.apply(null, ms.map(function (x) { return x.actualBoundingBoxAscent; })), desc = Math.max.apply(null, ms.map(function (x) { return x.actualBoundingBoxDescent; }));
    var s = rowsTall / (asc + desc), cols = Math.ceil((right - left) * s) + 2, rows = rowsTall + 2, k = 4;
    var mask = document.createElement('canvas'); mask.width = cols * k; mask.height = rows * k;
    var mc = mask.getContext('2d'); mc.font = (100 * s * k) + 'px Anton';
    var starts = xs.map(function (x, j) { return 1 + (x - ms[j].actualBoundingBoxLeft - left) * s; });
    for (var j = 0; j < text.length; j++) mc.fillText(text[j], (1 + (xs[j] - left) * s) * k, (1 + asc * s) * k);
    var ink = mc.getImageData(0, 0, mask.width, mask.height).data, dots = [];
    for (var r = 0; r < rows; r++) for (var c = 0; c < cols; c++) {
      var cov = 0;
      for (var y = 0; y < k; y++) for (var x = 0; x < k; x++) cov += ink[((r * k + y) * mask.width + c * k + x) * 4 + 3];
      cov /= k * k * 255;
      if (cov <= 0.05) continue;
      var ch = 0; for (var q = 0; q < starts.length; q++) if (c >= starts[q] - 0.5) ch = q;
      dots.push({ c: c, r: r, cov: cov, ch: ch, d: 0.6 * c / cols + 0.4 * rand(c, r) });
    }
    return { dots: dots, w: cols, h: rows };
  }

  // A 5 x 7 dot font for the LED board and the printer
  var F = {
