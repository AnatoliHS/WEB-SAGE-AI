  }
  // The dots of a leaf: pointed at both ends, widest a third of the way out, L long, pointing at
  // angle a from (0, 0); each with how far out it is (t)
  function leaf(L, Wd, a, P) {
    var out = [], ca = Math.cos(a), sa = Math.sin(a);
    for (var u = P; u <= L; u += P) {
      var t = u / L, half = Wd / 2 * Math.pow(Math.sin(Math.PI * Math.pow(t, 0.75)), 0.9);
