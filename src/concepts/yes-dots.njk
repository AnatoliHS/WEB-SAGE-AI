  };
  // The dots of str at (x, y), P apart, the first n characters lit (on), the rest unlit (off, or skipped)
  function led(c, str, x, y, P, onCol, offCol, n, r) {
    var R = r || P * 0.36;
    for (var i = 0; i < str.length; i++) {
      var g = F[str[i]] || F[' '], lit = n === undefined || i < n;
      for (var q = 0; q < 35; q++) {
        var on = g[q] === '#' && lit, cx = x + (i * 6 + (q % 5) + 0.5) * P, cy = y + (Math.floor(q / 5) + 0.5) * P;
        if (on) dot(c, cx, cy, R, typeof onCol === 'function' ? onCol(i) : onCol);
        else if (offCol) dot(c, cx, cy, R * 0.75, offCol);
